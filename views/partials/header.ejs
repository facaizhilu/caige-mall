<%# 全站共用页头(朱红金,与首页同色同高)。一级页(首页/分类/购物车/我的):左侧横版标志 + 搜索;二级页:左返回 + 小标志 + 标题;右侧约 100px 留给微信小程序胶囊按钮 %>
<% const TOP = ['/', '/products', '/cart', '/me'].includes(req.path); %>
<% if (TOP) { %><div class="head zh">
  <a class="brand zh-brand" href="/" aria-label="首页"><picture><source type="image/svg+xml" srcset="/static/img/logo-horizontal-onred.svg?v=1"><img class="logo zh-logo" src="/static/img/logo-horizontal-onred-64.png?v=1" srcset="/static/img/logo-horizontal-onred-64.png?v=1 2x,/static/img/logo-horizontal-onred-96.png?v=1 3x" alt="韵农甄选" width="100" height="32" decoding="async" fetchpriority="high"></picture></a>
  <form class="search zh-search" action="/products" method="get" role="search"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg><input name="q" type="search" enterkeyhint="search" autocomplete="off" maxlength="40" aria-label="搜索商品" placeholder="搜索商品"<% if (typeof q === 'string' && q) { %> value="<%= q %>"<% } %>><button>搜索</button></form>
</div><% } else { %><div class="head zh zh-sub">
  <a class="zh-back" href="/" onclick="if(history.length>1&&document.referrer.indexOf(location.host)>-1){history.back();return false}" aria-label="返回"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></a>
  <a class="zh-brand zh-mini" href="/" aria-label="首页"><picture><source type="image/svg+xml" srcset="/static/img/logo-horizontal-onred.svg?v=1"><img class="zh-logo" src="/static/img/logo-horizontal-onred-64.png?v=1" srcset="/static/img/logo-horizontal-onred-64.png?v=1 2x,/static/img/logo-horizontal-onred-96.png?v=1 3x" alt="韵农甄选" width="100" height="32" decoding="async"></picture></a>
  <h1 class="zh-title"><%= title %></h1>
</div><% } %>
