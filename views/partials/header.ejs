<%# 全站共用页头(清新绿)。首页:弧形渐变头 + 标志 + 搜索;分类:渐变头 + 标志 + 搜索;购物车:渐变头 + 标题;我的:页面自带个人信息头;其余二级页:白色导航栏(返回 + 居中标题)。右侧预留微信小程序胶囊位 %>
<% const HP = req.path, HOME = HP === '/', TOP = ['/', '/products', '/cart', '/me'].includes(HP); %>
<% if (HOME || HP === '/products') { %><div class="head zh gh<%= HOME ? ' gh-arc' : '' %>"><i class="gh-c1"></i><i class="gh-c2"></i><i class="gh-c3"></i>
  <div class="gh-row"><a class="brand zh-brand gh-shop gh-original" href="/" aria-label="韵农甄选 首页"><span class="orig-mark"><img src="/static/img/logo-orig-mark.svg?v=1" alt="韵农甄选原Logo" width="28" height="28"></span><span>韵农甄选</span></a><% if (HOME) { %><a class="gh-msg" href="/cart" aria-label="购物车"><%- include('ic', { icn: 'cart', isz: 24 }) %><i class="gh-badge js-cart-n<%= cartCount ? '' : ' hide' %>"><%= cartCount %></i></a><% } %></div>
  <form class="search zh-search" action="/products" method="get" role="search"><%- include('ic', { icn: 'search', isz: 17 }) %><input name="q" type="search" enterkeyhint="search" autocomplete="off" maxlength="40" aria-label="搜索商品" placeholder="<%= HOME ? '搜索商品名称' : '搜索商品' %>"<% if (typeof q === 'string' && q) { %> value="<%= q %>"<% } %>><button>搜索</button></form>
</div><% } else if (HP === '/cart') { %><div class="head zh gh gh-title"><i class="gh-c1"></i><h1 class="zh-title"><%= title %></h1></div>
<% } else if (HP === '/me') { %><% } else { %><div class="head zh zh-sub gn">
  <a class="zh-back" href="/" onclick="if(history.length>1&&document.referrer.indexOf(location.host)>-1){history.back();return false}" aria-label="返回"><%- include('ic', { icn: 'back', isz: 22 }) %></a>
  <h1 class="zh-title"><%= title %></h1>
</div><% } %>
