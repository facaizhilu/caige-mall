<%# 全站共用底部导航(与首页同一份):图标/配色/字号一致,当前页红色高亮;二级页按所属一级栏目高亮(商品/分类/活动→分类,购物车/结算/支付→购物车,其余订单/积分/地址/设置/客服等→我的) %>
<% const NX=(['/login','/register'].includes(req.path) && typeof req.query.next==='string' && /^\/(?!\/)/.test(req.query.next)) ? req.query.next.split(/[?#]/)[0] : '', P=(NX && NX!=='/me' && !NX.startsWith('/me/')) ? (NX==='/'||NX==='/products'||NX==='/cart'||NX.startsWith('/category') ? NX : '/me') : req.path, act={home:P==='/'}; { const C=/^\/(products|category|product\/|brand|search|activity|groupbuy|group\/|coupons)/, K=/^\/(cart|checkout|pay)/; act.cat=C.test(P)||P.startsWith('/products'); act.cart=K.test(P); act.me=!act.home&&!act.cat&&!act.cart; }; const A=k=>act[k]?' class="on" aria-current="page"':''; %>
<nav class="tab ztab" aria-label="底部导航">
  <a href="/"<%- A('home') %>><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true"><path d="M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z"/></svg><span>首页</span></a>
  <a href="/products"<%- A('cat') %>><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true"><rect x="3" y="3" width="7.5" height="7.5" rx="2"/><rect x="13.5" y="3" width="7.5" height="7.5" rx="3.75"/><rect x="3" y="13.5" width="7.5" height="7.5" rx="2"/><rect x="13.5" y="13.5" width="7.5" height="7.5" rx="2"/></svg><span>分类</span></a>
  <a href="/cart"<%- A('cart') %>><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true"><path d="M3 4h2.5l2.2 11h11l2-8H7"/><circle cx="9" cy="19.5" r="1.4"/><circle cx="17" cy="19.5" r="1.4"/></svg><span>购物车</span><% if (cartCount) { %><i class="badge"><%= cartCount %></i><% } %></a>
  <a href="<%= user?'/me':'/login' %>"<%- A('me') %>><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c1-4.5 4.5-6.5 8-6.5s7 2 8 6.5"/></svg><span>我的</span></a>
</nav>
