<%# 全站共用底部导航(与首页同一份):图标/配色/字号一致,当前页绿色高亮;二级页按所属一级栏目高亮(商品/分类/活动→分类,购物车/结算/支付→购物车,其余订单/积分/地址/设置/客服等→我的) %>
<% const NX=(['/login','/register'].includes(req.path) && typeof req.query.next==='string' && /^\/(?!\/)/.test(req.query.next)) ? req.query.next.split(/[?#]/)[0] : '', P=(NX && NX!=='/me' && !NX.startsWith('/me/')) ? (NX==='/'||NX==='/products'||NX==='/cart'||NX.startsWith('/category') ? NX : '/me') : req.path, act={home:P==='/'}; { const C=/^\/(products|category|product\/|brand|search|activity|groupbuy|group\/|coupons)/, K=/^\/(cart|checkout|pay)/; act.cat=C.test(P)||P.startsWith('/products'); act.cart=K.test(P); act.me=!act.home&&!act.cat&&!act.cart; }; const A=k=>act[k]?' class="on" aria-current="page"':''; %>
<nav class="tab ztab" aria-label="底部导航">
  <a href="/"<%- A('home') %>><%- include('ic', { icn: 'home', isz: 24 }) %><span>首页</span></a>
  <a href="/products"<%- A('cat') %>><%- include('ic', { icn: 'grid', isz: 24 }) %><span>分类</span></a>
  <a href="/cart"<%- A('cart') %>><%- include('ic', { icn: 'cart', isz: 24 }) %><span>购物车</span><i class="badge js-cart-n<%= cartCount ? '' : ' hide' %>" id="cartBadge"><%= cartCount %></i></a>
  <a href="<%= user?'/me':'/login' %>"<%- A('me') %>><%- include('ic', { icn: 'user', isz: 24 }) %><span>我的</span></a>
</nav>
