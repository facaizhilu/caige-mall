<% if (pg.pages > 1) { %>
<div class="pager">
  <% if (pg.page > 1) { %><a href="<%= qs(req,{page:pg.page-1}) %>">上一页</a><% } %>
  <% for (let i=1;i<=pg.pages;i++) { if (i===1||i===pg.pages||Math.abs(i-pg.page)<=2) { %>
    <% if (i===pg.page) { %><span class="on"><%= i %></span><% } else { %><a href="<%= qs(req,{page:i}) %>"><%= i %></a><% } %>
  <% } else if (Math.abs(i-pg.page)===3) { %><span>…</span><% } } %>
  <% if (pg.page < pg.pages) { %><a href="<%= qs(req,{page:pg.page+1}) %>">下一页</a><% } %>
</div>
<% } %>
