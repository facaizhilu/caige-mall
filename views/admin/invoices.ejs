<div class="card"><div class="flex" style="margin-bottom:12px"><a class="btn sm <%= !st?'primary':'' %>" href="/admin/invoices">全部</a><a class="btn sm <%= st==='pending'?'primary':'' %>" href="?status=pending">待开具</a><a class="btn sm <%= st==='issued'?'primary':'' %>" href="?status=issued">已开具</a><a class="btn sm <%= st==='rejected'?'primary':'' %>" href="?status=rejected">已驳回</a></div>
<table class="t"><tr><th>订单</th><th>会员</th><th>类型/抬头</th><th>税号</th><th>邮箱</th><th>金额</th><th>状态</th><th>操作</th></tr><% pg.rows.forEach(i=>{ %><tr><td><a href="/admin/orders/<%= i.order_id %>"><%= i.order_no %></a></td><td><%= i.phone %></td><td><%= i.type==='company'?'企业':'个人' %> · <%= i.title %></td><td><%= i.tax_no||'-' %></td><td><%= i.email %></td><td>¥<%= i.amount.toFixed(2) %></td><td><span class="os <%= i.status %>"><%= {pending:'待开具',issued:'已开具',rejected:'已驳回'}[i.status] %></span><br><span class="muted"><%= i.invoice_no||i.admin_note||'' %></span></td>
<td><% if(i.status==='pending'){ %><form method="post" action="/admin/invoices/<%= i.id %>/handle" class="flex"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm ok" name="action" value="issue">开具</button><input name="admin_note" placeholder="驳回原因" style="width:110px"><button class="btn sm danger" name="action" value="reject">驳回</button></form><% } %></td></tr><% }) %></table><%- include('../partials/apager') %></div>
