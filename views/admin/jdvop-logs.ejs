<div class="card"><form class="toolbar" method="get"><input type="search" name="q" value="<%= q %>" placeholder="接口/信息"><select name="ok"><option value="">全部</option><option value="1" <%= ok==='1'?'selected':'' %>>成功</option><option value="0" <%= ok==='0'?'selected':'' %>>失败</option></select><button class="btn">筛选</button></form>
<p class="help">记录每次供应商接口调用(密钥、签名已脱敏,收货人手机号/姓名已打码)。</p>
<div class="tbl-wrap"><table class="t"><tr><th>时间</th><th>接口</th><th>结果</th><th>耗时</th><th>详情</th></tr><% pg.rows.forEach(l=>{ %><tr><td class="muted" style="white-space:nowrap"><%= l.created_at %></td><td><b><%= l.interface_code %></b><br><span class="muted"><%= l.mode %></span></td><td><span class="tag <%= l.ok?'green':'' %>"><%= l.ok?'成功':'失败' %></span> <%= l.code||'' %><br><span style="font-size:12px;overflow-wrap:anywhere"><%= l.msg %></span></td><td><%= l.duration_ms %>ms</td>
 <td><details><summary class="btn sm">查看</summary><div class="pre">请求:<%= l.request %></div><div class="pre mt">响应:<%= l.response %></div></details></td></tr><% }) %>
<% if(!pg.rows.length){ %><tr><td colspan="5" class="muted" style="text-align:center;padding:30px">暂无调用记录</td></tr><% } %></table></div><%- include('../partials/apager') %></div>
<div class="card"><h3>最近回调(<%= cbs.length %>)</h3><div class="tbl-wrap"><table class="t"><tr><th>时间</th><th>类型</th><th>处理结果</th><th>报文</th></tr><% cbs.forEach(c=>{ %><tr><td class="muted" style="white-space:nowrap"><%= c.created_at %></td><td><%= c.type %></td><td style="overflow-wrap:anywhere"><%= c.result %></td><td><details><summary class="btn sm">查看</summary><div class="pre"><%= c.payload %></div></details></td></tr><% }) %></table></div></div>
