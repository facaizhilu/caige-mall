<div class="grid g2" style="grid-template-columns:1fr 2fr"><div class="card"><h3>会话列表</h3>
<% convs.forEach(c=>{ %><a href="/admin/service?uid=<%= c.user_id %>" style="display:block;padding:10px;border-radius:8px;<%= cur&&cur.id===c.user_id?'background:#fdeceb':'' %>"><b><%= c.nickname %></b> <span class="muted"><%= c.phone %></span> <% if(c.lastSender==='user'){ %><span class="tag">待回复</span><% } %><br><span class="muted"><%= c.last.slice(0,24) %> · <%= c.time.slice(5,16) %></span></a><% }) %><% if(!convs.length){ %><span class="muted">暂无会话</span><% } %></div>
<div class="card"><% if(cur){ %><h3>与 <%= cur.nickname %> (<%= cur.phone %>) 的对话</h3><div class="chat" id="chat"><% msgs.forEach(m=>{ %><div class="msg <%= m.sender==='staff'?'staff':'' %>"><%= m.content %><small><%= m.created_at %> · <%= {user:'会员',staff:'客服',bot:'智能助手'}[m.sender] %></small></div><% }) %></div>
<form method="post" action="/admin/service/<%= cur.id %>/reply" class="flex mt"><input type="hidden" name="_csrf" value="<%= csrf %>"><input name="content" placeholder="输入回复…" required maxlength="500"><button class="btn primary">发送</button></form><script>var c=document.getElementById('chat');c.scrollTop=c.scrollHeight</script><% } else { %><span class="muted">请选择左侧会话</span><% } %></div></div>
