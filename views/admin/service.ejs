<div class="grid g2 svc-grid" style="grid-template-columns:1fr 2fr"><div class="card"><h3>会话列表</h3><div id="convs">
<% convs.forEach(c=>{ %><a href="/admin/service?uid=<%= c.user_id %>" style="display:block;padding:10px;border-radius:8px;<%= cur&&cur.id===c.user_id?'background:#fdeceb':'' %>"><b><%= c.nickname %></b> <span class="muted"><%= c.phone %></span> <% if(c.unread){ %><span class="tag">待回复</span> <span class="un-dot" title="未回复消息数"><%= c.unread > 99 ? '99+' : c.unread %></span><% } %><br><span class="muted"><%= c.last.slice(0,24) %> · <%= c.time.slice(5,16) %></span></a><% }) %><% if(!convs.length){ %><span class="muted">暂无会话</span><% } %></div></div>
<div><div class="card"><% if(cur){ %><h3>与 <%= cur.nickname %> (<%= cur.phone %>) 的对话<small class="muted" style="font-weight:400;font-size:12px;margin-left:6px">人工消息发送后 <%= recallMin %> 分钟内可撤回/编辑</small> <a class="btn sm" href="/admin/members/<%= cur.id %>">会员详情</a></h3><div class="chat" id="chat" data-uid="<%= cur.id %>"><% msgs.forEach(m=>{ %><div id="m<%= m.id %>" class="msg <%= m.sender==='staff'?'staff':'' %> <%= m.recalled_at?'recalled':'' %> <%= /^我要申请售后/.test(m.content||'')?'as-req':'' %>"><% if (m.recalled_at) { %><i class="muted">【已撤回】</i><% } else if (m.kind==='image' && m.data && m.data.images) { %><span class="svc-imgs"><% m.data.images.forEach(u=>{ %><a href="<%= u %>" target="_blank" rel="noopener"><img src="<%= u %>" alt="图片" style="width:96px;height:96px;object-fit:cover;border-radius:6px;margin:2px"></a><% }) %></span><% } else if (m.kind==='order' && m.order) { %><a class="svc-ordcard" href="/admin/orders/<%= m.order.id %>">🧾 订单 <b><%= m.order.order_no %></b> · ¥<%= Number(m.order.pay_amount).toFixed(2) %> · <%= ORDER_STATUS[m.order.status] %> ›</a><% } else { %><%= m.content %><% } %><small><%= m.created_at %> · <%= {user:'会员',staff:'人工客服',bot:'自动回复',system:'系统通知'}[m.sender] %><% if (m.edited_at && !m.recalled_at) { %> · 已编辑<% } %><% if (m.sender==='staff' && !m.recalled_at) { %> · <% if (m.read_at) { %>已读 <%= m.read_at.slice(5,16) %><% } else { %><span class="rd-un">未读</span><% } %><% } %></small>
<% if (m.canMod) { %><span class="msg-ops"><form method="post" action="/admin/service/<%= cur.id %>/msg/<%= m.id %>/recall" data-confirm="确认撤回这条消息?会员端将显示「客服撤回了一条消息」"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm">撤回</button></form><% if ((m.kind||'text')==='text') { %><details class="msg-edit"><summary class="btn sm">编辑</summary><form method="post" action="/admin/service/<%= cur.id %>/msg/<%= m.id %>/edit"><label>修改消息内容(会员端将显示「已编辑」)<textarea name="content" rows="3" maxlength="500" required placeholder="请输入修改后的内容"><%= m.content %></textarea></label><input type="hidden" name="_csrf" value="<%= csrf %>"><span class="msg-edit-btns"><button type="submit" class="btn sm">保存修改</button><button type="button" class="btn sm cancel" onclick="this.closest('details').open=false">取消</button></span></form></details><% } %></span><% } %>
<% if (m.audit && m.audit.length) { %><details class="msg-audit"><summary>操作记录(<%= m.audit.length %>)· 仅后台可见</summary><% m.audit.forEach(a=>{ %><div><%= a.created_at %> · <%= a.operator %> · <%= a.action==='recall'?'撤回':'编辑' %> · 原文:<%= a.old_content %><% if (a.old_payload) { %> [含图片]<% } %><% if (a.new_content) { %> → <%= a.new_content %><% } %></div><% }) %></details><% } %></div><% }) %></div>
<form method="post" action="/admin/service/<%= cur.id %>/reply" enctype="multipart/form-data" class="flex mt wrapf"><input type="hidden" name="_csrf" value="<%= csrf %>"><input name="content" placeholder="输入回复…" maxlength="500" style="flex:1"><label class="btn sm">🖼 图片<input type="file" name="images" accept="image/*" multiple hidden></label><button class="btn primary">发送</button></form><div class="muted" style="font-size:12px">可附最多 3 张图片(JPG/PNG/WebP/GIF,≤3MB)</div><script>var c=document.getElementById('chat');c.scrollTop=c.scrollHeight</script><% } else { %><span class="muted">请选择左侧会话</span><% } %></div>
<% if (cur) { %><div class="card"><% const asN = orders.filter(o=>o.active).length; %><details class="svc-ords"><summary><h3>该用户近期订单（<%= orders.length %>）<% if (asN) { %><span class="tag-as">售后中 <%= asN %></span><% } %><span class="arr"></span></h3></summary>
<% if (!orders.length) { %><span class="muted">暂无可售后的订单</span><% } %>
<% orders.forEach(o=>{ %><details class="svc-order"><summary class="so-line"><span class="arr"></span><b>…<%= String(o.order_no).slice(-6) %></b><span class="os <%= o.status %>"><%= ORDER_STATUS[o.status] %></span><span>实付 ¥<%= o.pay_amount.toFixed(2) %></span><span class="muted"><%= String(o.created_at||"").slice(0,10) %></span><% if (o.active) { %><i class="as-dot" title="售后进行中"></i><% } %></summary>
  <div class="flex between wrapf"><div><a href="/admin/orders/<%= o.id %>"><b><%= o.order_no %></b></a> <span class="os <%= o.status %>"><%= ORDER_STATUS[o.status] %></span> <span class="muted">实付 ¥<%= o.pay_amount.toFixed(2) %><%= o.points_used ? ' + ' + o.points_used + '积分' : '' %> · <%= o.created_at.slice(0,16) %></span></div>
  <div class="muted" style="font-size:12px"><% if (o.daysSince !== null) { %>签收 <b><%= o.daysSince %></b> 天<% } else { %>未签收<% } %> · <%- o.noReason ? '<span class="tag green">支持7天无理由</span>' : '<span class="tag">含不支持7天无理由商品</span>' %><%- o.no7_confirmed ? ' <span class="tag gray">下单已确认</span>' : '' %></div></div>
  <div class="muted" style="font-size:12px;margin:4px 0"><%= o.items.map(i=>i.name + (i.spec_text?'('+i.spec_text+')':'') + ' ×' + i.qty).join('、') %></div>
  <% if (o.active) { %><a class="btn sm" href="/admin/aftersales/<%= o.active.id %>">进行中的售后单 #<%= o.active.id %>(<%= AFTERSALE_STATUS[o.active.status] %>)</a>
  <% } else if (o.canCreate && o.maxAmount >= 0) { %><details <%= msgs.some(m=>m.sender==='user'&&m.content.includes(o.order_no)) ? 'open' : '' %>><summary class="btn sm primary">创建售后单</summary>
    <form method="post" action="/admin/service/<%= cur.id %>/aftersale" class="as-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="order_id" value="<%= o.id %>">
      <div class="form-row"><label>售后类型</label><select name="type" required>
        <% if (o.status==='paid') { %><option value="refund">仅退款(未发货)</option><% } else { %>
        <option value="quality">质量问题退换货</option>
        <% if (o.can7) { %><option value="no_reason">7天无理由退货(签收第 <%= o.daysSince %> 天)</option><% } %>
        <option value="refund_return">退货退款</option>
        <option value="refund">仅退款</option><% } %>
      </select><% if (o.status!=='paid' && !o.can7) { %><div class="muted" style="font-size:12px">「7天无理由退货」不可用:<%= !o.noReason ? '含不支持7天无理由的商品' : o.daysSince===null ? '尚未签收' : '已超过签收后 7 天' %></div><% } %></div>
      <div class="form-row"><label>原因</label><input name="reason" required maxlength="50" placeholder="如:商品破损 / 尺码不合适"></div>
      <div class="form-row"><label>退款金额(最多 ¥<%= o.maxAmount.toFixed(2) %>)</label><input type="number" name="amount" step="0.01" min="0" max="<%= o.maxAmount %>" value="<%= o.maxAmount.toFixed(2) %>" required><div class="muted" style="font-size:12px">退款完成时现金原路退回;订单使用的 <%= o.points_used %> 积分按比例退回</div></div>
      <div class="form-row"><label>备注</label><textarea name="note" rows="2" maxlength="500" placeholder="客服核实情况(选填)"></textarea></div>
      <button class="btn primary sm">创建并通知用户</button></form></details>
  <% } else { %><span class="muted" style="font-size:12px">该订单当前不可创建售后</span><% } %>
</details><% }) %></details></div><% } %></div></div>

<script src="/static/js/admin-service.js?v=3" defer></script>
