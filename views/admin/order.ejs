<div class="grid g2" style="grid-template-columns:2fr 1fr">
<div>
 <div class="card"><div class="flex between"><h3 style="margin:0">订单 <%= o.order_no %></h3><span class="os <%= o.status %>" style="font-size:14px"><%= ORDER_STATUS[o.status] %></span></div>
  <div class="grid g2 mt"><dl class="kv"><dt>会员</dt><dd><a href="/admin/members/<%= o.user_id %>"><%= o.nickname %></a> <%= o.uphone %></dd><dt>下单时间</dt><dd><%= o.created_at %></dd><dt>支付方式</dt><dd><%= o.pay_method?PAY_METHOD[o.pay_method]:'-' %></dd><dt>支付时间</dt><dd><%= o.paid_at||'-' %></dd><dt>类型</dt><dd><%= {normal:'普通订单',seckill:'秒杀',group:'拼团',points:'积分兑换'}[o.type] %></dd><dt>7天无理由</dt><dd><%- o.no7_confirmed ? '<span class="tag">含不支持商品 · 用户下单时已确认知晓</span>' : '<span class="muted">支持 / 不涉及</span>' %></dd></dl>
  <dl class="kv"><dt>收货人</dt><dd><%= o.receiver %> <%= o.phone %></dd><dt>地址</dt><dd><%= o.province %> <%= o.city %> <%= o.district %> <%= o.detail %></dd><dt>买家备注</dt><dd><%= o.remark||'-' %></dd><% if(o.tracking_no){ %><dt>物流</dt><dd><%= o.express_company %> <%= o.tracking_no %></dd><% } %><% if(group){ %><dt>拼团</dt><dd><%= {open:'拼团中 '+group.joined+'/'+group.need,success:'已成团',failed:'失败'}[group.status] %></dd><% } %></dl></div>
  <% if(['unpaid','paid'].includes(o.status)){ %><details class="fold mt"><summary>修改收货信息</summary><form method="post" action="/admin/orders/<%= o.id %>/address" class="flex wrapf mt"><input type="hidden" name="_csrf" value="<%= csrf %>"><input name="receiver" value="<%= o.receiver %>" style="width:120px"><input name="phone" value="<%= o.phone %>" style="width:140px"><input name="detail" value="<%= o.detail %>" style="flex:1;min-width:200px"><button class="btn sm primary">保存</button></form></details><% } %></div>
 <div class="card"><h3>商品明细</h3><table class="t"><tr><th>商品</th><th>单价</th><th>数量</th><th class="right">小计</th></tr><% items.forEach(i=>{ %><tr><td><div class="flex"><img class="thumb" src="<%= i.image %>"><div><%= i.name %><br><span class="muted"><%= i.spec_text %></span></div></div></td><td>¥<%= i.price %></td><td>×<%= i.qty %></td><td class="right">¥<%= (i.price*i.qty).toFixed(2) %></td></tr><% }) %></table>
  <dl class="kv" style="grid-template-columns:1fr auto;max-width:320px;margin-left:auto;margin-top:12px"><dt>商品金额</dt><dd class="right"><%= money(o.goods_amount) %></dd><dt>运费</dt><dd class="right"><%= money(o.freight) %></dd><dt>会员折扣</dt><dd class="right">-<%= money(o.level_discount) %></dd><dt>优惠券</dt><dd class="right">-<%= money(o.coupon_discount) %></dd><dt>积分抵扣</dt><dd class="right">-<%= money(o.points_discount) %></dd><dt><b>实付</b></dt><dd class="right price" style="font-size:18px"><%= money(o.pay_amount) %></dd></dl></div>
 <div class="card"><h3>订单轨迹</h3><ul class="timeline"><% traces.forEach(t=>{ %><li><%= t.text %><time><%= t.time %></time></li><% }) %></ul>
  <% if(['paid','shipped'].includes(o.status)){ %><form method="post" action="/admin/orders/<%= o.id %>/trace" class="flex"><input type="hidden" name="_csrf" value="<%= csrf %>"><input name="text" placeholder="手动添加物流/备注节点(留空=模拟推进物流)"><button class="btn sm">添加</button></form><% } %></div>
</div>
<div>
 <% const canShip = o.status==='paid' && (o.type!=='group' || (group&&group.status==='success')); %>
 <div class="card" id="ship"><h3>订单操作</h3>
  <% if(canShip){ %><form method="post" action="/admin/orders/<%= o.id %>/ship"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="form-row"><label>快递公司</label><select name="company"><% COMPANIES.forEach(c=>{ %><option><%= c %></option><% }) %></select></div><div class="form-row"><label>运单号</label><input name="tracking_no" required placeholder="6-30位字母数字" pattern="[A-Za-z0-9\-]{6,30}"></div><button class="btn primary" style="width:100%;justify-content:center">确认发货</button></form>
  <% } else if(o.status==='paid'){ %><p class="muted">拼团尚未成团,成团后方可发货。</p><% } else if(o.status==='shipped'){ %><p>已发货:<%= o.express_company %> <%= o.tracking_no %><br><span class="muted"><%= o.shipped_at %></span></p><% } else { %><p class="muted">当前状态无可用的发货操作</p><% } %>
  <% if(['unpaid','paid','shipped'].includes(o.status)){ %><hr style="border:0;border-top:1px solid var(--line);margin:14px 0"><form method="post" action="/admin/orders/<%= o.id %>/cancel" data-confirm="<%= o.status==='unpaid'?'确定取消该订单?':'该订单已支付,取消将全额退款(原路退回),订单使用的积分同步退回,确定?' %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="form-row"><label>取消原因</label><input name="reason" placeholder="如:缺货/用户申请"></div><button class="btn danger" style="width:100%;justify-content:center"><%= o.status==='unpaid'?'取消订单':'取消并退款' %></button></form><% } %></div>
 <div class="card"><h3>商家备注</h3><form method="post" action="/admin/orders/<%= o.id %>/remark"><input type="hidden" name="_csrf" value="<%= csrf %>"><textarea name="admin_remark" rows="3"><%= o.admin_remark||'' %></textarea><button class="btn sm mt">保存备注</button></form></div>
 <% if(aftersale){ %><div class="card"><h3>售后</h3><p><span class="os <%= aftersale.status %>"><%= AFTERSALE_STATUS[aftersale.status] %></span> <%= aftersale.type==='refund'?'仅退款':'退货退款' %></p><a class="btn sm" href="/admin/aftersales/<%= aftersale.id %>">处理售后</a></div><% } %>
 <% if(invoice){ %><div class="card"><h3>发票</h3><p><%= invoice.title %> · <%= {pending:'待开具',issued:'已开具',rejected:'已驳回'}[invoice.status] %></p><a class="btn sm" href="/admin/invoices">发票管理</a></div><% } %>
</div></div>
