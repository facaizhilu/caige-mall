<% const E=k=>errs[k]?'<div style="color:#d93025;font-size:12px;margin-top:4px">'+String(errs[k]).replace(/[<>&"]/g,'')+'</div>':''; const req='<b style="color:#d93025">*</b> '; %>
<div class="card"><h3>关于韵农甄选</h3><div style="background:#E8F6EE;border:1px solid #BFE5CD;color:#1F6B3F;border-radius:8px;padding:10px 12px;margin-bottom:12px">这里编辑前台「我的 → 关于我们」和页面底部「关于韵农甄选」显示的内容。可以上传图片、编辑文字，保存后立即在前台生效。内容须真实，不能使用违禁词。 <a href="/about" target="_blank">前台查看 ›</a></div>
<form method="post" action="/admin/about" enctype="multipart/form-data" novalidate><input type="hidden" name="_csrf" value="<%= csrf %>">
<div class="form-row"><label><%- req %>标题</label><div><input name="title" maxlength="30" value="<%= d.title %>"><%- E('title') %></div></div>
<div class="form-row"><label>封面图（选填）</label><div><% if(d.cover){ %><img src="<%= d.cover %>" alt="" style="max-width:240px;max-height:120px;object-fit:cover;border-radius:6px;display:block;margin-bottom:6px"><input type="hidden" name="cover_url" value="<%= d.cover %>"><label style="font-size:12px;font-weight:normal"><input type="checkbox" name="cover_del" value="1"> 删除封面图</label><br><% } %><input type="file" name="cover_file" accept="image/png,image/jpeg,image/gif,image/webp"><div class="muted" style="font-size:12px">建议横图 750×400，单张 3MB 以内<%= d.cover?'；不选新图则保留当前图片':'；不传则显示韵农甄选 Logo' %></div><%- E('cover') %></div></div>
<div class="form-row"><label>简介（选填）</label><div><textarea name="intro" rows="3" maxlength="300" placeholder="一两句话介绍韵农甄选"><%= d.intro %></textarea><%- E('intro') %></div></div>
<%- E('blocks') %>
<% for(let i=0;i<max;i++){ const b=d.blocks[i]||{text:'',image:''}; const show=i===0||d.blocks[i]||d.blocks[i-1]; %>
<div class="form-row about-block" data-i="<%= i %>" <%= show?'':'hidden' %>><label>第 <%= i+1 %> 段</label><div style="border:1px solid #e5e5e5;border-radius:8px;padding:10px">
<textarea name="text_<%= i %>" rows="5" maxlength="2000" placeholder="文字，换行即分段"><%= b.text %></textarea><%- E('text_'+i) %>
<div style="margin-top:8px"><% if(b.image){ %><img src="<%= b.image %>" alt="" style="max-width:200px;max-height:120px;object-fit:cover;border-radius:6px;display:block;margin-bottom:6px"><input type="hidden" name="img_url_<%= i %>" value="<%= b.image %>"><label style="font-size:12px;font-weight:normal"><input type="checkbox" name="img_del_<%= i %>" value="1"> 删除这张图片</label><br><% } %>图片（选填）：<input type="file" name="img_file_<%= i %>" accept="image/png,image/jpeg,image/gif,image/webp"><span class="muted" style="font-size:12px">图片显示在本段文字上方，3MB 以内</span></div>
<div class="muted" style="font-size:12px;margin-top:4px">清空文字并删除图片即可删除本段</div></div></div>
<% } %>
<div class="form-row"><label></label><div><button type="button" class="btn" id="about-add">+ 添加一段</button> <span class="muted" style="font-size:12px">最多 <%= max %> 段</span></div></div>
<div class="form-row"><label></label><div><button class="btn primary">保存并发布</button></div></div>
</form></div>
<script>document.getElementById('about-add').onclick=function(){var h=document.querySelector('.about-block[hidden]');if(h){h.hidden=false;h.querySelector('textarea').focus();}if(!document.querySelector('.about-block[hidden]'))this.disabled=true;};</script>
