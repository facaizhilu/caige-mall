<% const imgs = U.jsonArr(p.images); %>
<% if (typeof bannedHits !== 'undefined' && bannedHits && !(flash && flash.type === 'warn')) { %><div class="flash warn">⚠️ 违禁/敏感词提示:<%= bannedHits %>。请核实并修改相关文案(<a href="/admin/banned-words">管理违禁词表</a>)。</div><% } %>
<form method="post" action="/admin/products/save" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= p.id||'' %>">
<% if (p.supplier) { %><div class="flash <%= p.supplier_state==='pending_review'||p.supplier_state==='blocked' ? 'warn' : 'info' %>">🏭 供应商商品(SKU 由供应商同步):售价按「供应商设置」中的加价规则自动维护,库存跟随供应商可售状态,此处修改价格/库存/规格不生效;不展示划线价。<% if (p.supplier_review_note) { %><br><b>导入审核:</b><%= p.supplier_review_note %>(修改名称/副标题/详情并保存后自动复检,通过后才可上架)<% } %></div><% } %>
<div class="card"><h3>基本信息</h3><div class="form-grid">
 <div class="form-row" style="grid-column:1/-1"><label>商品名称 *</label><input type="text" name="name" value="<%= p.name %>" required maxlength="80"></div>
 <div class="form-row" style="grid-column:1/-1"><label>副标题/卖点</label><input type="text" name="subtitle" value="<%= p.subtitle %>" maxlength="100"></div>
 <div class="form-row"><label>分类 *</label><select name="category_id"><option value="">请选择</option><% cats.filter(c=>c.parent).forEach(c=>{ %><option value="<%= c.v %>" <%= p.category_id==c.v?'selected':'' %><%- c.scope ? ' data-scope="' + U.esc(c.scope) + '"' : '' %>><%= c.t.replace('　└ ','') %></option><% }) %></select><% const scopeHintNow = p.supplier ? '' : (cats.find(c => String(c.v) === String(p.category_id)) || {}).scope || (typeof scopeHint !== 'undefined' ? scopeHint : '') || ''; %><div class="flash warn scope-hint"<%- scopeHintNow ? '' : ' hidden' %> style="margin-top:6px;font-size:13px">⚠️ 经营范围提示:<span><%= scopeHintNow %></span>。仅提示不拦截;经营范围变更前请勿上架销售。</div><script>(function(){var s=document.currentScript.parentNode.querySelector('select[name=category_id]'),h=document.currentScript.previousElementSibling;if(!s||!h)return;s.addEventListener('change',function(){var o=s.options[s.selectedIndex],m=o&&o.getAttribute('data-scope')||'';h.querySelector('span').textContent=m;h.hidden=!m;});})();</script><div class="help">仅可选择二级分类</div></div>
 <div class="form-row"><label>品牌</label><select name="brand_id"><option value="0">无</option><% brands.forEach(b=>{ %><option value="<%= b.id %>" <%= p.brand_id==b.id?'selected':'' %>><%= b.name %></option><% }) %></select></div>
 <div class="form-row"><label>划线原价(元,选填)</label><input type="number" step="0.01" min="0" name="market_price" value="<%= p.market_price > 0 ? p.market_price : '' %>" placeholder="留空则不显示划线价"><div class="help">仅可填写本商品曾真实销售过的价格,不确定请留空(《明码标价和禁止价格欺诈规定》)</div></div>
 <div class="form-row"><label>运费模板 *</label><select name="template_id" required><option value="">请选择运费模板</option><% tpls.forEach(t=>{ %><option value="<%= t.id %>" <%= p.template_id==t.id?'selected':'' %>><%= t.name %></option><% }) %></select></div>
 <div class="form-row"><label>推荐排序(权重,大的在前)</label><input type="number" name="sort" value="<%= p.sort||0 %>" step="1"><div class="help">用于「全部商品」综合排序:置顶 → 权重 → 新品</div></div>
 <div class="form-row"><label>供应商销量(仅后台参考)</label><input type="number" name="supplier_sales" min="0" step="1" value="<%= p.supplier_sales==null?'':p.supplier_sales %>" placeholder="留空"><div class="help">预留给供应商接口,仅供内部参考,前台永不展示;前台销量只按真实订单计算(当前 <%= p.sales||0 %>)</div></div>
 <div class="form-row"><label>重量(kg)</label><input type="number" step="0.01" name="weight" value="<%= p.weight||0.5 %>"></div>
</div>
<div class="flex wrapf"><label><input type="checkbox" name="status" value="1" <%= p.status?'checked':'' %>> 上架</label><label><input type="checkbox" name="is_top" value="1" <%= p.is_top?'checked':'' %>> 置顶</label><span class="help">「热卖」「新品」标签由系统按真实销量与上架时间自动显示(见 站点设置)</span></div>
 <div class="form-row mt"><label>支持七天无理由退货</label><select name="no_reason_return"><option value="" <%= p.no_reason_return==null?'selected':'' %>>跟随分类(默认支持;「鲜活易腐类」分类默认不支持)</option><option value="1" <%= p.no_reason_return===1?'selected':'' %>>支持7天无理由退货</option><option value="0" <%= p.no_reason_return===0?'selected':'' %>>不支持7天无理由退货</option></select><div class="muted" style="font-size:12px">不支持的商品,用户加购/下单前须勾选确认「本商品不支持7天无理由退货,我已知晓」</div></div></div>
<div class="card"><h3>商品图片 <span class="muted" style="font-weight:400">(第一张为主图,最多 9 张)</span></h3>
 <div class="imgs"><% imgs.forEach(i=>{ %><div class="im"><img src="<%= i %>"><label><input type="checkbox" name="images_keep" value="<%= i %>" checked> 保留</label></div><% }) %></div>
 <div class="form-row mt"><label>上传新图片(png/jpg/gif/webp,≤3MB)</label><input type="file" name="image_files" accept="image/*" multiple></div>
 <div class="form-row"><label>或粘贴图片地址(每行一个,以 / 或 http 开头)</label><textarea name="image_urls" rows="2"></textarea></div>
 <div class="help">不添加图片时将无主图,前台会显示默认占位图。</div></div>
<div class="card"><h3>规格与库存(SKU)</h3>
 <div class="form-row" style="max-width:420px"><label>规格名称(逗号分隔,最多 3 项)</label><input type="text" name="spec_names" id="specNames" value="<%= p.spec_names %>" placeholder="如:颜色,尺码"></div>
 <p class="help">每行一个 SKU,规格值用「/」分隔且与规格名称顺序对应,例如规格名称「颜色,尺码」→ 规格值「黑色 / L」。已有订单引用的 SKU 不会被物理删除。</p>
 <table class="t" id="skuTable"><tr><th>规格值</th><th>价格(元)</th><th>库存</th><th>编码</th><th></th></tr>
 <% skus.forEach(s=>{ const attrs = typeof s.attrs==='string'?JSON.parse(s.attrs||'{}'):s.attrs; %><tr><td><input type="hidden" name="sku_id" value="<%= s.id||'' %>"><input type="text" name="sku_spec" value="<%= Object.values(attrs).join(' / ') %>"></td><td><input type="number" step="0.01" min="0" name="sku_price" value="<%= s.price %>"></td><td><input type="number" min="0" name="sku_stock" value="<%= s.stock %>"></td><td><input type="text" name="sku_code" value="<%= s.code||'' %>"></td><td><button type="button" class="btn sm danger" onclick="this.closest('tr').remove()">移除</button></td></tr><% }) %></table>
 <button type="button" class="btn sm mt" onclick="addSku()">＋ 添加规格</button></div>
<div class="card"><h3>商品详情(支持 HTML)</h3><textarea name="description" rows="8"><%= p.description %></textarea></div>
<button class="btn primary" style="padding:9px 30px">保存商品</button> <a class="btn" href="/admin/products">返回列表</a></form>
<script>function addSku(){var t=document.getElementById('skuTable');var tr=document.createElement('tr');tr.innerHTML='<td><input type="hidden" name="sku_id" value=""><input type="text" name="sku_spec"></td><td><input type="number" step="0.01" min="0" name="sku_price"></td><td><input type="number" min="0" name="sku_stock" value="100"></td><td><input type="text" name="sku_code"></td><td><button type="button" class="btn sm danger" onclick="this.closest(\'tr\').remove()">移除</button></td>';t.appendChild(tr)}</script>
