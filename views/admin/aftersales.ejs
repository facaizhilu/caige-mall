<div class="card"><div class="flex wrapf" style="margin-bottom:12px"><a class="btn sm <%= !st?'primary':'' %>" href="/admin/aftersales">全部</a><% Object.keys(AFTERSALE_STATUS).forEach(k=>{ %><a class="btn sm <%= st===k?'primary':'' %>" href="/admin/aftersales?status=<%= k %>"><%= AFTERSALE_STATUS[k] %></a><% }) %></div>
<table class="t"><tr><th>ID</th><th>订单号</th><th>会员</th><th>类型</th><th>原因</th><th>金额</th><th>状态</th><th>时间</th><th></th></tr>
<% pg.rows.forEach(a=>{ %><tr><td><%= a.id %></td><td><a href="/admin/orders/<%= a.order_id %>"><%= a.order_no %></a></td><td><%= a.nickname %><br><span class="muted"><%= a.phone %></span></td><td><%= a.type==='refund'?'仅退款':'退货退款' %></td><td><%= a.reason %></td><td class="price">¥<%= a.amount.toFixed(2) %></td><td><span class="os <%= a.status %>"><%= AFTERSALE_STATUS[a.status] %></span></td><td class="muted"><%= a.created_at.slice(0,16) %></td><td><a class="btn sm primary" href="/admin/aftersales/<%= a.id %>">处理</a></td></tr><% }) %>
<% if(!pg.rows.length){ %><tr><td colspan="9" class="muted" style="text-align:center;padding:30px">暂无售后单</td></tr><% } %></table><%- include('../partials/apager') %></div>
