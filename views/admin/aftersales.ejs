<div class="card"><p class="muted" style="margin-top:0">售后单由客服在「客服中心」会话中根据用户申请创建;退款时现金原路退回,订单使用的积分按比例退回,并扣回该订单奖励的积分/成长值。</p><div class="flex wrapf" style="margin-bottom:12px"><a class="btn sm <%= !st?'primary':'' %>" href="/admin/aftersales">全部</a><% Object.keys(AFTERSALE_STATUS).forEach(k=>{ %><a class="btn sm <%= st===k?'primary':'' %>" href="/admin/aftersales?status=<%= k %>"><%= AFTERSALE_STATUS[k] %></a><% }) %></div>
<table class="t"><tr><th>ID</th><th>订单号</th><th>会员</th><th>类型</th><th>原因</th><th>金额</th><th>状态</th><th>时间</th><th></th></tr>
<% pg.rows.forEach(a=>{ %><tr><td><%= a.id %></td><td><a href="/admin/orders/<%= a.order_id %>"><%= a.order_no %></a></td><td><%= a.nickname %><br><span class="muted"><%= a.phone %></span></td><td><%= AFTERSALE_TYPE[a.type]||a.type %><% if (a.created_by) { %><br><span class="muted">客服 <%= a.created_by %> 创建</span><% } %></td><td><%= a.reason %></td><td class="price">¥<%= a.amount.toFixed(2) %><% if (a.status==='refunded') { %><br><span class="muted" style="font-size:12px">退积分 <%= a.refund_points||0 %> / 退现金 ¥<%= (a.refund_cash||0).toFixed(2) %></span><% } %></td><td><span class="os <%= a.status %>"><%= AFTERSALE_STATUS[a.status] %></span></td><td class="muted"><%= a.created_at.slice(0,16) %></td><td><a class="btn sm primary" href="/admin/aftersales/<%= a.id %>">处理</a></td></tr><% }) %>
<% if(!pg.rows.length){ %><tr><td colspan="9" class="muted" style="text-align:center;padding:30px">暂无售后单</td></tr><% } %></table><%- include('../partials/apager') %></div>
