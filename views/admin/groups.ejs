<div class="card"><table class="t"><tr><th>团号</th><th>商品</th><th>团长</th><th>进度</th><th>状态</th><th>截止</th></tr><% rows.forEach(g=>{ %><tr><td>#<%= g.id %></td><td><%= g.pname %></td><td><%= g.nickname %></td><td><%= g.joined %>/<%= g.need %></td><td><span class="tag <%= g.status==='success'?'green':(g.status==='failed'?'gray':'') %>"><%= {open:'拼团中',success:'已成团',failed:'失败'}[g.status] %></span></td><td class="muted"><%= g.expire_at %></td></tr><% }) %><% if(!rows.length){ %><tr><td colspan="6" class="muted" style="text-align:center;padding:24px">暂无拼团</td></tr><% } %></table><p class="muted">拼团超时未成团会自动失败并将已付款订单退款至用户余额。</p></div>
