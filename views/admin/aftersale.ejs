<div class="grid g2" style="grid-template-columns:2fr 1fr"><div class="card"><div class="flex between"><h3 style="margin:0">售后单 #<%= a.id %></h3><span class="os <%= a.status %>"><%= AFTERSALE_STATUS[a.status] %></span></div>
<dl class="kv mt"><dt>订单</dt><dd><a href="/admin/orders/<%= a.order_id %>"><%= a.order_no %></a>(<%= ORDER_STATUS[a.ostatus] %>)</dd><dt>会员</dt><dd><%= a.nickname %> <%= a.phone %></dd><dt>类型</dt><dd><%= a.type==='refund'?'仅退款':'退货退款' %></dd><dt>退款金额</dt><dd class="price">¥<%= a.amount.toFixed(2) %></dd><dt>原因</dt><dd><%= a.reason %></dd><dt>描述</dt><dd><%= a.description||'-' %></dd><dt>申请时间</dt><dd><%= a.created_at %></dd><% if(a.return_tracking){ %><dt>退货物流</dt><dd><%= a.return_express %> <%= a.return_tracking %></dd><% } %><dt>处理说明</dt><dd><%= a.admin_note||'-' %></dd></dl>
<% if(imgs.length){ %><div class="imgs mt"><% imgs.forEach(i=>{ %><img src="<%= i %>"><% }) %></div><% } %>
<h3 class="mt">涉及商品</h3><% items.forEach(i=>{ %><div class="flex" style="margin:4px 0"><img class="thumb" src="<%= i.image %>"><%= i.name %> <span class="muted"><%= i.spec_text %> ×<%= i.qty %></span></div><% }) %></div>
<div class="card"><h3>处理</h3>
<% if(['pending','returned'].includes(a.status)){ %><form method="post" action="/admin/aftersales/<%= a.id %>/handle"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="form-row"><label>处理说明</label><textarea name="admin_note" rows="3"></textarea></div>
 <% if(a.status==='pending'){ %><button class="btn primary" name="action" value="approve" style="width:100%;justify-content:center;margin-bottom:8px"><%= a.type==='refund'?'同意并退款':'同意退货' %></button><% } else { %><button class="btn ok" name="action" value="receive" style="width:100%;justify-content:center;margin-bottom:8px" data-x>已收到退货,确认退款</button><% } %>
 <button class="btn danger" name="action" value="reject" style="width:100%;justify-content:center">拒绝</button></form>
<% } else if(a.status==='approved_return'){ %><p class="muted">等待买家寄回商品。</p><% } else { %><p class="muted">该售后单已结束。</p><% } %></div></div>
