<div class="grid g2" style="grid-template-columns:2fr 1fr"><div class="card"><div class="flex between"><h3 style="margin:0">售后单 #<%= a.id %></h3><span class="os <%= a.status %>"><%= AFTERSALE_STATUS[a.status] %></span></div>
<dl class="kv mt"><dt>订单</dt><dd><a href="/admin/orders/<%= a.order_id %>"><%= a.order_no %></a>(<%= ORDER_STATUS[a.ostatus] %>)<% if (a.no7_confirmed) { %> <span class="tag">下单时已确认不支持7天无理由</span><% } %></dd><dt>会员</dt><dd><%= a.nickname %> <%= a.ucancel ? '(已注销)' : a.phone %> · <a href="/admin/service?uid=<%= a.user_id %>">客服会话</a></dd>
<dt>类型</dt><dd><%= AFTERSALE_TYPE[a.type]||a.type %></dd>
<dt>订单实付</dt><dd>¥<%= a.pay_amount.toFixed(2) %><% if (a.points_used) { %> + 积分抵扣 <%= a.points_used %> 分(¥<%= (a.points_discount||0).toFixed(2) %>)<% } %></dd>
<dt>申请退款</dt><dd class="price">¥<%= a.amount.toFixed(2) %></dd>
<dt>退款拆分</dt><dd><% if (a.status==='refunded') { %><b>退积分 <%= a.refund_points||0 %> / 退现金 ¥<%= (a.refund_cash||0).toFixed(2) %></b> <span class="tag green"><%= a.refund_channel||'原路退回' %></span><br><span class="muted"><%= a.refunded_at %></span><% } else if (['exchanged','rejected','cancelled'].includes(a.status)) { %>-<% } else { %>预计 退积分 <%= a.estPoints %> / 退现金 ¥<%= a.amount.toFixed(2) %>(原路退回)<br><span class="muted">按退款金额占实付比例退回积分<%= a.points_awarded ? ',并按比例扣回该订单奖励的 ' + a.points_awarded + ' 积分及成长值' : '' %></span><% } %></dd>
<dt>原因</dt><dd><%= a.reason %></dd><dt>说明/备注</dt><dd><%= a.description||'-' %></dd><dt>创建</dt><dd><%= a.created_at %><%= a.created_by ? ' · 客服 ' + a.created_by : ' · 用户申请' %></dd><% if(a.return_tracking){ %><dt>退货物流</dt><dd><%= a.return_express %> <%= a.return_tracking %></dd><% } %><dt>处理说明</dt><dd><%= a.admin_note||'-' %></dd></dl>
<h3 class="mt">涉及商品</h3><% items.forEach(i=>{ %><div class="flex" style="margin:4px 0"><img class="thumb" src="<%= i.image %>"><%= i.name %> <span class="muted"><%= i.spec_text %> ×<%= i.qty %></span></div><% }) %></div>
<div class="card"><h3>处理</h3>
<% if(['pending','returned'].includes(a.status)){ %><form method="post" action="/admin/aftersales/<%= a.id %>/handle"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="form-row"><label>处理说明(将通过客服消息通知用户)</label><textarea name="admin_note" rows="3"></textarea></div>
 <% if(a.status==='pending'){ %><button class="btn primary" name="action" value="approve" style="width:100%;justify-content:center;margin-bottom:8px" data-confirm="<%= a.type==='refund' ? '确认退款?现金原路退回,积分按比例退回' : '同意退货?' %>"><%= a.type==='refund'?'同意并退款(原路退回)':'同意退货' %></button><% } else { %><button class="btn ok" name="action" value="receive" style="width:100%;justify-content:center;margin-bottom:8px" data-confirm="确认已收到退货并退款?">已收到退货,确认退款(原路退回)</button><% if (a.type==='quality') { %><button class="btn" name="action" value="exchange" style="width:100%;justify-content:center;margin-bottom:8px">已收到退货,换货寄出</button><% } %><% } %>
 <button class="btn danger" name="action" value="reject" style="width:100%;justify-content:center">拒绝</button></form>
<% } else if(a.status==='approved_return'){ %><p class="muted">等待买家寄回商品并填写退货单号。</p><% } else { %><p class="muted">该售后单已结束。</p><% } %>
<p class="muted" style="font-size:12px">退款为「原路退回」记录(真实微信退款接口后续接入),不再退至账户余额。每次状态变更会自动向用户发送客服消息。</p></div></div>
