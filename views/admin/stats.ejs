<div class="toolbar"><% [7,30,90].forEach(d=>{ %><a class="btn sm <%= range===d?'primary':'' %>" href="?days=<%= d %>">近 <%= d %> 天</a><% }) %><span class="sp"></span><a class="btn" href="/admin/orders/export">导出订单CSV</a><a class="btn" href="/admin/members/export">导出会员CSV</a><a class="btn" href="/admin/export/products">导出商品库存CSV</a><a class="btn" href="/admin/logs/export">导出操作日志CSV</a></div>
<div class="grid g4"><div class="kpi r"><span>期间销售额</span><b>¥<%= sum.a.toFixed(2) %></b></div><div class="kpi"><span>期间订单数</span><b><%= sum.n %></b></div><div class="kpi go"><span>会员总数 / 购买会员</span><b><%= conv.users %> / <%= conv.buyers %></b><small>转化率 <%= conv.users?Math.round(conv.buyers/conv.users*100):0 %>%</small></div><div class="kpi"><span>复购会员</span><b><%= conv.repeat %></b><small>复购率 <%= conv.buyers?Math.round(conv.repeat/conv.buyers*100):0 %>%</small></div></div>
<div class="card mt"><h3>销售趋势(销售额 / 订单数)</h3><%- salesChart %></div>
<div class="card"><h3>会员增长趋势</h3><%- userChart %></div>
<div class="grid g2"><div class="card"><h3>分类销售占比(元)</h3><%- catChart %></div><div class="card"><h3>支付方式分布(单)</h3><%- payChart %></div></div>
<div class="grid g2"><div class="card"><h3>商品销售排行 TOP10</h3><table class="t"><tr><th>#</th><th>商品</th><th>销量</th><th class="right">销售额</th></tr><% topProducts.forEach((p,i)=>{ %><tr><td><%= i+1 %></td><td><%= p.label %></td><td><%= p.qty %></td><td class="right">¥<%= p.amt.toFixed(2) %></td></tr><% }) %></table></div>
<div><div class="card"><h3>会员等级分布</h3><%- levelChart %></div><div class="card"><h3>消费会员排行</h3><table class="t"><% topUsers.forEach((u,i)=>{ %><tr><td><%= i+1 %></td><td><a href="/admin/members/<%= u.id %>"><%= u.nickname %></a></td><td><%= u.n %> 单</td><td class="right">¥<%= u.amt.toFixed(2) %></td></tr><% }) %></table></div></div></div>
