<div class="card"><form class="toolbar" method="get"><input type="search" name="q" value="<%= q %>" placeholder="手机号/昵称/邀请码" style="min-width:200px">
<select name="level"><option value="">全部等级</option><% levels.forEach(l=>{ %><option value="<%= l.id %>" <%= String(level)===String(l.id)?'selected':'' %>><%= l.name %></option><% }) %></select>
<select name="status"><option value="">全部状态</option><option value="1" <%= status==='1'?'selected':'' %>>正常</option><option value="0" <%= status==='0'?'selected':'' %>>已禁用</option><option value="cancelled" <%= status==='cancelled'?'selected':'' %>>已注销</option></select>
<select name="consent"><option value="">协议同意:全部</option><option value="1" <%= consent==='1'?'selected':'' %>>已同意</option><option value="0" <%= consent==='0'?'selected':'' %>>未同意</option></select>
<select name="sort"><option value="">最新注册</option><option value="spent" <%= sort==='spent'?'selected':'' %>>累计消费</option><option value="points" <%= sort==='points'?'selected':'' %>>积分最多</option></select>
<button class="btn">查询</button><span class="sp"></span><a class="btn" href="/admin/members/export">导出会员CSV</a></form>
<div class="tbl-wrap"><table class="t"><tr><th>ID</th><th>会员</th><th>等级</th><th>积分</th><th>累计消费</th><th>订单</th><th>注册时间</th><th>协议同意</th><th>状态</th><th>操作</th></tr>
<% pg.rows.forEach(u=>{ %><tr><td><%= u.id %></td><td><b><%= u.nickname %></b><br><span class="muted"><%= u.phone %></span></td><td><span class="tag gold" style="color:<%= u.level_color %>"><%= u.level_name %></span><br><span class="muted">成长值 <%= u.growth %></span></td><td><%= u.points %></td><td>¥<%= u.total_spent.toFixed(2) %></td><td><%= u.order_count %></td><td class="muted"><%= u.created_at.slice(0,10) %></td><td class="muted"><%= u.consent_at ? u.consent_at.slice(0,16) : '未同意' %></td><td><%- u.cancelled_at?'<span class="tag gray">已注销</span>':u.status?'<span class="tag green">正常</span>':'<span class="tag gray">已禁用</span>' %></td>
<td style="white-space:nowrap"><a class="btn sm" href="/admin/members/<%= u.id %>">详情</a> <% if (!u.cancelled_at) { %><form method="post" action="/admin/members/<%= u.id %>/status" style="display:inline" data-confirm="<%= u.status?'确定禁用该会员?禁用后将无法登录':'确定启用?' %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm <%= u.status?'danger':'' %>"><%= u.status?'禁用':'启用' %></button></form><% } %></td></tr><% }) %></table></div><%- include('../partials/apager') %></div>
