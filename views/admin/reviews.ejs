<div class="card"><p class="muted" style="margin-top:0">评价为纯文字 + 星级,不支持上传图片。</p><form class="toolbar" method="get"><select name="status" onchange="this.form.submit()"><option value="">全部状态</option><option value="pending" <%= st==='pending'?'selected':'' %>>待审核</option><option value="approved" <%= st==='approved'?'selected':'' %>>已通过</option><option value="rejected" <%= st==='rejected'?'selected':'' %>>已拒绝</option></select><input type="search" name="q" value="<%= q %>" placeholder="评价内容/商品"><button class="btn">搜索</button></form>
<% pg.rows.forEach(r=>{ %><div style="border-bottom:1px solid var(--line);padding:14px 0"><div class="flex between"><div><a href="/product/<%= r.product_id %>" target="_blank"><b><%= r.pname %></b></a> <span class="muted">· <%= r.nickname %> <%= r.phone %> · <%= r.created_at %></span></div><span class="os <%= r.status %>"><%= {pending:'待审核',approved:'已通过',rejected:'已拒绝',hidden:'用户已注销'}[r.status] %></span></div>
<div style="color:#f5a623;letter-spacing:2px"><%= '★'.repeat(r.rating)+'☆'.repeat(5-r.rating) %></div><div><%= r.content %></div>
<% if(r.reply){ %><div class="muted mt">商家回复:<%= r.reply %></div><% } %>
<div class="flex wrapf mt"><% if(r.status!=='approved'){ %><form method="post" action="/admin/reviews/<%= r.id %>/approve"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm ok">通过</button></form><% } %><% if(r.status!=='rejected'){ %><form method="post" action="/admin/reviews/<%= r.id %>/reject"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm">拒绝/隐藏</button></form><% } %>
<form method="post" action="/admin/reviews/<%= r.id %>/reply" class="flex"><input type="hidden" name="_csrf" value="<%= csrf %>"><input name="reply" placeholder="回复买家…" value="<%= r.reply||'' %>" style="width:260px"><button class="btn sm">回复</button></form>
<form method="post" action="/admin/reviews/<%= r.id %>/delete" data-confirm="删除该评价?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm danger">删除</button></form></div></div><% }) %>
<% if(!pg.rows.length){ %><div class="muted" style="text-align:center;padding:30px">暂无评价</div><% } %><%- include('../partials/apager') %></div>
