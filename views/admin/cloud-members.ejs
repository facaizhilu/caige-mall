<div class="card"><p class="muted" style="margin-top:0">开通 / 续期 / 停用请进入会员详情的「云商卡」卡片操作,并登记线下销售信息(实收金额、日期、卡类型、经办员工、收据/发票备注)。</p><form class="toolbar" method="get">
  <input type="search" name="q" value="<%= q %>" placeholder="手机号/昵称" style="min-width:180px">
  <select name="tier"><option value="">全部档位</option><option value="silver" <%= tier==='silver'?'selected':'' %>>白银</option><option value="gold" <%= tier==='gold'?'selected':'' %>>黄金</option></select>
  <select name="active"><option value="">全部状态</option><option value="1" <%= active==='1'?'selected':'' %>>权益生效中</option><option value="0" <%= active==='0'?'selected':'' %>>已到期/停用</option></select>
  <button class="btn">查询</button>
</form>
<div class="tbl-wrap"><table class="t"><tr><th>会员</th><th>档位</th><th>卡类型</th><th>开始</th><th>到期</th><th>状态</th><th>积分</th><th></th></tr>
<% if (!pg.rows.length) { %><tr><td colspan="8" class="muted">暂无</td></tr><% } %>
<% pg.rows.forEach(u=>{ %><tr>
  <td><b><%= u.nickname %></b><br><span class="muted"><%= u.phone %></span></td>
  <td><%= u.tierLabel %></td>
  <td><%= u.card_name || '-' %></td>
  <td class="muted"><%= u.cloud_start ? u.cloud_start.slice(0,10) : '-' %></td>
  <td class="muted"><%= u.cloud_end ? u.cloud_end.slice(0,10) : '-' %></td>
  <td><%- u.active ? '<span class="tag green">生效中</span>' : '<span class="tag gray">已到期/停用</span>' %></td>
  <td><%= u.points %></td>
  <td><a class="btn sm" href="/admin/members/<%= u.id %>#cloud">开通/续期</a></td>
</tr><% }) %></table></div><%- include('../partials/apager') %></div>
<div class="card"><h3>线下销售 / 开通记录(最近 30 条)</h3>
<div class="tbl-wrap"><table class="t"><tr><th>时间</th><th>会员</th><th>操作</th><th>卡类型</th><th class="right">实收金额</th><th>销售日期</th><th>经办员工</th><th>收据/发票备注</th><th>有效期</th><th>操作人</th></tr>
<% if (!sales.length) { %><tr><td colspan="10" class="muted">暂无</td></tr><% } %>
<% sales.forEach(x=>{ %><tr><td class="muted"><%= x.created_at.slice(0,16) %></td><td><a href="/admin/members/<%= x.user_id %>"><%= x.nickname %></a></td><td><%= {open:'开通',renew:'续期',stop:'停用'}[x.action]||x.action %></td><td><%= x.card_name||'-' %></td><td class="right"><%= x.action==='stop' ? '-' : '¥' + Number(x.amount).toFixed(2) %></td><td><%= x.sale_date||'-' %></td><td><%= x.staff||'-' %></td><td><%= x.receipt_note||'-' %></td><td class="muted"><%= String(x.start_at||'').slice(0,10) %> ~ <%= String(x.end_at||'').slice(0,10) %></td><td><%= x.admin_name||'-' %></td></tr><% }) %>
</table></div></div>
