<div class="card"><div class="ag-hint" style="background:#E8F6EE;border:1px solid #BFE5CD;color:#1F6B3F;border-radius:8px;padding:10px 12px;margin-bottom:10px">此处上传的商品只在活动专区显示，不会出现在商城首页和分类里</div>
<div class="toolbar"><b>活动专区商品</b><span class="sp"></span><a class="btn primary" href="/admin/activity-goods/new">＋ 添加活动专区商品</a></div>
<div class="tbl-wrap"><table class="t"><tr><th>商品</th><th>活动价 / 划线价</th><th>库存(已售/总)</th><th>活动时间</th><th>发货方</th><th>状态</th><th>操作</th></tr>
<% rows.forEach(x=>{ const t=now.slice(0,16).replace(' ','T'); %><tr><td><span class="ag-tag" style="display:inline-block;background:#2E9E5B;color:#fff;font-size:11px;border-radius:4px;padding:1px 6px;margin-right:6px">活动专区</span><% if(x.image){ %><img src="<%= x.image %>" alt="" style="width:36px;height:36px;object-fit:cover;border-radius:4px;vertical-align:middle;margin-right:6px"><% } %><a href="/product/<%= x.id %>?preview=1" target="_blank"><%= x.name %></a></td>
<td><b class="price">¥<%= x.price %></b><% if(x.market_price){ %> <s class="muted">¥<%= x.market_price %></s><% } %></td><td><%= x.sold %>/<%= x.stock %></td><td style="font-size:12px"><%= x.start_at.replace('T',' ') %> ~ <%= x.end_at.replace('T',' ') %></td><td style="font-size:12px"><%= x.ship_from %></td>
<td><% if(!x.on){ %><span class="tag gray">已下架</span><% } else if(x.end_at<t){ %><span class="tag gray">已结束</span><% } else if(x.start_at>t){ %><span class="tag gold">未开始</span><% } else { %><span class="tag">展示中</span><% } %></td>
<td style="white-space:nowrap"><a class="btn sm" href="/admin/activity-goods/<%= x.id %>/edit">编辑</a> <form method="post" action="/admin/activity-goods/<%= x.id %>/toggle" style="display:inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm"><%= x.on?'下架':'上架' %></button></form> <form method="post" action="/admin/activity-goods/<%= x.id %>/delete" style="display:inline" data-confirm="确定删除?此操作不可恢复"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm danger">删除</button></form></td></tr><% }) %>
<% if(!rows.length){ %><tr><td colspan="7" class="muted" style="text-align:center;padding:24px">还没有活动专区商品，点右上角「添加活动专区商品」上传</td></tr><% } %></table></div></div>
