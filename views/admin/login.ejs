<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>管理员登录 - <%= shop.shop_name %></title><link rel="icon" href="/favicon.ico"><link rel="stylesheet" href="/static/css/admin.css?v=2"></head>
<body><div class="login-bg"><form class="login-card" method="post" action="/admin/login"><input type="hidden" name="_csrf" value="<%= csrf %>">
<h2 style="color:var(--red)">🛡️ <%= shop.shop_name %> 管理后台</h2><div class="sub">仅限授权管理员登录</div>
<% if (flash) { %><div class="flash <%= flash.type %>"><%= flash.msg %></div><% } %>
<div class="form-row"><label>管理员账号</label><input type="text" name="username" required autofocus autocomplete="username"></div>
<div class="form-row"><label>密码</label><input type="password" name="password" required autocomplete="current-password"></div>
<button class="btn primary" style="width:100%;justify-content:center;padding:10px">登 录</button>
<p class="muted" style="text-align:center;margin:14px 0 0"><a href="/">← 返回商城</a></p></form></div></body></html>
