<div class="card"><div class="toolbar"><b>邀请人 <%= U.maskPhone(u.phone) %>（<%= u.nickname %>）</b><span class="sp"></span><a class="btn" href="/admin/ac/user/<%= u.id %>/export">导出表格</a></div>
<dl class="kv ac-sum"><dt>累计邀请</dt><dd id="sumInvited"><%= sum.invited %></dd><dt>已计入</dt><dd id="sumCounted"><%= sum.counted %></dd><dt>已发专享券</dt><dd id="sumCoupons"><%= sum.coupons %></dd></dl></div>
<% if (!list.length) { %><div class="card muted">该会员还没有活动专区邀请记录</div><% } %>
<% list.forEach(p=>{ %><div class="card"><h3 style="margin-top:0">订单 <a href="/admin/orders/<%= p.c.order_id %>"><%= p.orderNo %></a>，进度 <%= p.counted %>/<%= p.need %> <span class="muted" style="font-size:12px"><%= p.statusLabel %> · 截止 <%= p.deadline %><% if (p.reward!=null) { %> · 专享券 ¥<%= (+p.reward).toFixed(2) %><% } %></span></h3>
<div class="tbl-wrap"><table class="t"><tr><th>好友手机号</th><th>邀请时间</th><th>好友订单</th><th>实付</th><th>状态</th><th>未计入原因</th><th>计入时间</th></tr>
<% if (!p.friends.length) { %><tr><td colspan="7" class="muted">暂无好友下单</td></tr><% } %>
<% p.friends.forEach(f=>{ %><tr><td><span class="ph"><%= U.maskPhone(f.friend_phone) %></span> <a href="javascript:void(0)" class="reveal" data-u="<%= u.id %>" data-f="<%= f.id %>" style="color:#2E9E5B">显示</a></td><td><%= f.created_at %></td><td><a href="/admin/orders/<%= f.order_id %>"><%= f.order_no %></a></td><td>¥<%= (+f.pay_amount||0).toFixed(2) %></td><td><%= f.slot.label %></td><td><%= f.state==='void' ? f.reason : f.state==='review' ? f.flag : '' %></td><td><%= f.counted_at||'' %></td></tr><% }) %>
</table></div></div><% }) %>
<script>document.querySelectorAll('.reveal').forEach(function(a){a.addEventListener('click',function(){fetch('/admin/ac/user/'+a.dataset.u+'/reveal/'+a.dataset.f,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded','X-CSRF-Token':CSRF},body:'_csrf='+encodeURIComponent(CSRF)}).then(function(r){return r.json()}).then(function(j){if(j.ok){a.previousElementSibling.textContent=j.phone;a.remove()}})})})</script>
