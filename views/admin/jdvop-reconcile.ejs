<% const SO_ST={pending:'待推送',submitted:'已预下单',confirmed:'已确认',failed:'失败',cancelling:'取消中',cancelled:'已取消'}; %>
<div class="card"><form class="toolbar" method="get"><input type="date" name="from" value="<%= from %>"><input type="date" name="to" value="<%= to %>"><button class="btn">筛选</button></form>
<div class="grid g4 mb"><div><div class="muted">顾客实付(供应商部分)</div><b style="font-size:18px"><%= money(rec.total.sale) %></b></div><div><div class="muted">已退顾客</div><b style="font-size:18px"><%= money(rec.total.custRefund) %></b></div><div><div class="muted">供应商扣款 / 已退回</div><b style="font-size:18px"><%= money(rec.total.cost) %> / <%= money(rec.total.supRefund) %></b></div><div><div class="muted">毛利</div><b style="font-size:18px;color:<%= rec.total.margin<0?'var(--red)':'inherit' %>"><%= money(rec.total.margin) %></b></div></div>
<p class="help">毛利 =(顾客实付 − 已退顾客)−(供应商扣款 − 供应商退回)。供应商扣款含商品、运费与服务费;以供应商订单详情的结算价为准(未取得时用预下单扣款)。</p>
<div class="tbl-wrap"><table class="t"><tr><th>订单</th><th>状态</th><th class="right">顾客实付</th><th class="right">已退顾客</th><th class="right">供应商扣款</th><th class="right">供应商退回</th><th class="right">毛利</th></tr>
<% rec.rows.forEach(r=>{ %><tr><td><a href="/admin/orders/<%= r.order_id %>"><%= r.order_no %></a><br><span class="muted" style="font-size:12px"><%= r.ocreated %> · <%= r.order_sn||'-' %></span></td><td><%= SO_ST[r.status]||r.status %> / <%= ORDER_STATUS[r.ostatus] %></td><td class="right"><%= money(r.sale_amount) %></td><td class="right"><%= money(r.custRefund) %></td><td class="right"><%= money(r.cost) %></td><td class="right"><%= money(r.supRefund) %></td><td class="right" style="color:<%= r.margin<0?'var(--red)':'inherit' %>"><%= money(r.margin) %></td></tr><% }) %>
<% if(!rec.rows.length){ %><tr><td colspan="7" class="muted" style="text-align:center;padding:30px">暂无供应商订单</td></tr><% } %></table></div></div>
