<div class="grid g2" style="grid-template-columns:1fr 2fr"><div>
 <div class="card"><div class="flex"><div style="width:56px;height:56px;border-radius:50%;background:linear-gradient(135deg,var(--gold),var(--red));color:#fff;display:grid;place-items:center;font-size:24px"><%= u.nickname.slice(0,1) %></div><div><b style="font-size:17px"><%= u.nickname %></b> <%- u.cancelled_at?'<span class="tag gray">已注销</span>':u.status?'<span class="tag green">正常</span>':'<span class="tag gray">已禁用</span>' %><br><span class="muted"><%= u.cancelled_at ? '(已匿名化)' : u.phone %></span></div></div>
 <dl class="kv mt"><dt>会员等级</dt><dd><b style="color:<%= u.level_color %>"><%= u.level_name %></b></dd><dt>成长值</dt><dd><%= u.growth %></dd><dt>积分</dt><dd><%= u.points %></dd><dt>累计消费</dt><dd>¥<%= u.total_spent.toFixed(2) %></dd><dt>优惠券</dt><dd><%= coupons %> 张可用</dd><dt>收藏</dt><dd><%= favs %></dd><dt>邀请码</dt><dd><%= u.invite_code||'-' %>(已邀请 <%= invitees %> 人)</dd><dt>推荐人</dt><dd><%= u.ref_name||'-' %></dd><dt>性别</dt><dd><%= u.gender %></dd><dt>协议同意</dt><dd><% if (u.consent_at) { %><%= u.consent_at %> <span class="tag green">v<%= u.consent_version %></span><% } else { %><span class="tag gray">未同意(下次登录时提示)</span><% } %></dd><% if (u.cancelled_at) { %><dt>注销时间</dt><dd><%= u.cancelled_at %></dd><% } %><dt>注册</dt><dd><%= u.created_at %></dd><dt>最近登录</dt><dd><%= u.last_login||'-' %></dd></dl>
 <% if (u.cancelled_at) { %><p class="muted mt">该账号已由用户注销:个人信息已删除/匿名化,订单记录匿名保留。</p><% } else { %><form method="post" action="/admin/members/<%= u.id %>/status" class="mt" data-confirm="确定变更会员状态?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn <%= u.status?'danger':'ok' %>"><%= u.status?'禁用该会员':'启用该会员' %></button></form><% } %></div>
 <div class="card"><h3>编辑资料/备注</h3><form method="post" action="/admin/members/<%= u.id %>/edit"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="form-row"><label>昵称</label><input name="nickname" value="<%= u.nickname %>"></div><div class="form-row"><label>管理员备注</label><textarea name="remark" rows="2"><%= u.remark||'' %></textarea></div><button class="btn sm primary">保存</button></form>
 <hr style="border:0;border-top:1px solid var(--line);margin:14px 0"><form method="post" action="/admin/members/<%= u.id %>/reset-password" class="flex" data-confirm="确定重置该会员密码?"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="text" name="password" placeholder="新密码(≥6位)"><button class="btn sm danger">重置密码</button></form></div></div>
<div>
 <div class="card"><h3>积分 / 等级调整</h3><div class="grid g2">
  <form method="post" action="/admin/members/<%= u.id %>/points"><input type="hidden" name="_csrf" value="<%= csrf %>"><label class="muted">调整积分(负数为扣减)</label><input type="number" name="delta" placeholder="如 100 或 -50" required><input type="text" name="reason" placeholder="原因" style="margin-top:6px"><button class="btn sm primary mt">调整积分</button></form>
  <div><form method="post" action="/admin/members/<%= u.id %>/level"><input type="hidden" name="_csrf" value="<%= csrf %>"><label class="muted">设置会员等级</label><select name="level_id"><% levels.forEach(l=>{ %><option value="<%= l.id %>" <%= l.id===u.level_id?'selected':'' %>><%= l.name %>(≥<%= l.min_growth %>)</option><% }) %></select><button class="btn sm primary mt">保存等级</button></form>
  <form method="post" action="/admin/members/<%= u.id %>/coupon" class="mt"><input type="hidden" name="_csrf" value="<%= csrf %>"><select name="coupon_id"><% db_coupons.forEach(c=>{ %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select><button class="btn sm mt">发放优惠券</button></form></div></div></div>
 <div class="card" id="cloud"><h3>云商卡(线下销售,后台开通)</h3>
  <p style="margin-top:0"><% if (cloudStatus.tier) { %><%- cloudStatus.active ? '<span class="tag green">生效中</span>' : '<span class="tag gray">已到期/停用</span>' %> <%= cloudStatus.tierLabel %> · <%= String(cloudStatus.start||'').slice(0,10) %> ~ <%= String(cloudStatus.end||'').slice(0,10) %><% } else { %><span class="muted">未开通</span><% } %></p>
  <% if (!u.cancelled_at) { %>
  <form method="post" action="/admin/members/<%= u.id %>/cloud" class="as-form"><input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="grid g2">
      <div class="form-row"><label>卡类型 *</label><select name="card_type_id" required><option value="">请选择</option><% cardTypes.forEach(t=>{ %><option value="<%= t.id %>"><%= t.name %>(参考价 ¥<%= Number(t.activation_fee).toFixed(2) %>)</option><% }) %></select></div>
      <div class="form-row"><label>实收金额(元) *</label><input type="number" step="0.01" min="0" name="amount" required></div>
      <div class="form-row"><label>销售日期 *</label><input type="date" name="sale_date" value="<%= today %>" required></div>
      <div class="form-row"><label>经办员工 *</label><input name="staff" maxlength="40" required></div>
      <div class="form-row"><label>生效日期(选填)</label><input type="date" name="start"><div class="help">留空:生效中则顺延,否则从今天起</div></div>
      <div class="form-row"><label>到期日期(选填)</label><input type="date" name="end"><div class="help">留空按卡类型时长自动计算</div></div>
    </div>
    <div class="form-row"><label>收据 / 发票备注</label><input name="receipt_note" maxlength="200" placeholder="如:收据号 NO.0012 / 已开电子发票"></div>
    <button class="btn sm primary"><%= cloudStatus.active ? '续期云商卡' : '开通云商卡' %></button>
  </form>
  <% if (cloudStatus.active) { %><form method="post" action="/admin/members/<%= u.id %>/cloud" class="flex mt" data-confirm="确定立即停用该会员的云商卡权益?"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="stop"><input name="note" placeholder="停用原因(如:线下退卡)"><button class="btn sm danger">停用</button></form><% } %>
  <% } %>
  <% if (cloudSales.length) { %><table class="t mt"><tr><th>时间</th><th>操作</th><th>卡类型</th><th class="right">实收</th><th>经办</th><th>备注</th></tr><% cloudSales.forEach(x=>{ %><tr><td class="muted"><%= x.sale_date %></td><td><%= {open:'开通',renew:'续期',stop:'停用'}[x.action]||x.action %></td><td><%= x.card_name||'-' %></td><td class="right"><%= x.action==='stop'?'-':'¥'+Number(x.amount).toFixed(2) %></td><td><%= x.staff||'-' %></td><td><%= x.receipt_note||'-' %></td></tr><% }) %></table><% } %>
 </div>
 <div class="card"><h3>收货地址</h3><% addrs.forEach(a=>{ %><div><%= a.name %> <%= a.phone %> · <%= a.province %><%= a.city %><%= a.district %><%= a.detail %> <%- a.is_default?'<span class="tag">默认</span>':'' %></div><% }) %><% if(!addrs.length){ %><span class="muted">暂无</span><% } %></div>
 <div class="card"><h3>最近订单</h3><table class="t"><% orders.forEach(o=>{ %><tr><td><a href="/admin/orders/<%= o.id %>"><%= o.order_no %></a></td><td>¥<%= o.pay_amount.toFixed(2) %></td><td><span class="os <%= o.status %>"><%= ORDER_STATUS[o.status] %></span></td><td class="muted"><%= o.created_at.slice(0,16) %></td></tr><% }) %></table></div>
 <div class="grid g2"><div class="card"><h3>积分记录</h3><table class="t"><% plog.forEach(l=>{ %><tr><td class="muted"><%= l.created_at.slice(5,16) %></td><td><%= l.reason %></td><td class="right"><b><%= l.delta>0?'+':'' %><%= l.delta %></b></td></tr><% }) %></table></div>
 <div class="card"><h3>售后记录</h3><table class="t"><% aftersales.forEach(a=>{ %><tr><td><a href="/admin/aftersales/<%= a.id %>">#<%= a.id %></a> <span class="muted"><%= a.order_no %></span></td><td><%= AFTERSALE_TYPE[a.type]||a.type %></td><td><span class="os <%= a.status %>"><%= AFTERSALE_STATUS[a.status] %></span><% if (a.status==='refunded') { %><br><span class="muted">退积分 <%= a.refund_points||0 %> / 退现金 ¥<%= (a.refund_cash||0).toFixed(2) %></span><% } %></td></tr><% }) %></table><% if(!aftersales.length){ %><span class="muted">暂无</span><% } %></div></div>
</div></div>
