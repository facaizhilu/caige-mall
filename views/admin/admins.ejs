<div class="grid g2" style="grid-template-columns:2fr 1fr"><div class="card"><table class="t"><tr><th>账号</th><th>姓名</th><th>角色</th><th>状态</th><th>最近登录</th><th>操作</th></tr><% rows.forEach(a=>{ %><tr><td><b><%= a.username %></b></td><td><%= a.name %></td><td><span class="tag gold"><%= a.role_name %></span></td><td><%- a.status?'<span class="tag green">正常</span>':'<span class="tag gray">停用</span>' %></td><td class="muted"><%= a.last_login||'-' %></td><td style="white-space:nowrap"><a class="btn sm" href="/admin/admins?edit=<%= a.id %>">编辑</a> <% if(a.id!==admin.id){ %><form method="post" action="/admin/admins/<%= a.id %>/delete" style="display:inline" data-confirm="确定删除管理员 <%= a.username %>?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm danger">删除</button></form><% } %></td></tr><% }) %></table><p class="muted">角色及权限请在「角色权限」中维护。</p></div>
<div class="card"><h3><%= edit?'编辑管理员':'新增管理员' %></h3><form method="post" action="/admin/admins/save"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= edit?edit.id:'' %>">
<div class="form-row"><label>账号</label><input name="username" value="<%= edit?edit.username:'' %>" required></div><div class="form-row"><label>姓名</label><input name="name" value="<%= edit?edit.name:'' %>"></div>
<div class="form-row"><label>密码<%= edit?'(不修改请留空)':'' %></label><input type="password" name="password" <%= edit?'':'required' %> placeholder="至少 8 位" autocomplete="new-password"></div>
<div class="form-row"><label>角色</label><select name="role_id"><% roles.forEach(r=>{ %><option value="<%= r.id %>" <%= edit&&edit.role_id===r.id?'selected':'' %>><%= r.name %></option><% }) %></select></div>
<label><input type="checkbox" name="status" value="1" <%= !edit||edit.status?'checked':'' %>> 启用</label><div class="mt"><button class="btn primary">保存</button> <% if(edit){ %><a class="btn" href="/admin/admins">取消</a><% } %></div></form></div></div>
