<div class="me"><%- include("_menu",{cur:"aftersales"}) %><div class="card"><h3 style="margin-top:0">退款 / 售后</h3>
<div class="sim mb">如需售后,请在订单详情点击「💬 联系客服申请售后」,客服核实后为您创建售后单,进度可在此查看。</div>
<table class="tbl"><tr><th>创建时间</th><th>订单号</th><th>类型</th><th>退款</th><th>状态</th><th></th></tr><% rows.forEach(a=>{ %><tr><td><%= a.created_at %></td><td><%= a.order_no %></td><td><%= AFTERSALE_TYPE[a.type]||a.type %></td><td><% if (a.status==='refunded') { %>¥<%= (a.refund_cash||0).toFixed(2) %><%= a.refund_points ? ' + ' + a.refund_points + '积分' : '' %><% } else { %><%= money(a.amount) %><% } %></td><td><span class="os <%= a.status %>"><%= AFTERSALE_STATUS[a.status] %></span></td><td><a href="/aftersale/<%= a.id %>">详情</a></td></tr><% }) %></table><% if(!rows.length){ %><div class="empty">暂无售后记录</div><% } %></div></div>
