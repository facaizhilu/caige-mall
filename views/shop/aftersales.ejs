<div class="me"><%- include("_menu",{cur:"aftersales"}) %><div class="card"><h3 style="margin-top:0">退款 / 售后</h3>
<table class="tbl"><tr><th>申请时间</th><th>订单号</th><th>类型</th><th>金额</th><th>状态</th><th></th></tr><% rows.forEach(a=>{ %><tr><td><%= a.created_at %></td><td><%= a.order_no %></td><td><%= a.type==='refund'?'仅退款':'退货退款' %></td><td><%= money(a.amount) %></td><td><span class="os <%= a.status %>"><%= AFTERSALE_STATUS[a.status] %></span></td><td><a href="/aftersale/<%= a.id %>">详情</a></td></tr><% }) %></table><% if(!rows.length){ %><div class="empty">暂无售后记录。可在订单详情中申请。</div><% } %></div></div>
