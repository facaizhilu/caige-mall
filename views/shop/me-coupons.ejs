<div class="me"><%- include("_menu",{cur:"coupons"}) %><div class="card"><div class="flex between"><h3 style="margin-top:0">我的优惠券</h3><a class="btn primary sm" href="/coupons">去领券中心</a></div>
<div class="tabs"><% [['unused','未使用'],['used','已使用'],['expired','已过期']].forEach(t=>{ %><a class="<%= st===t[0]?'on':'' %>" href="?status=<%= t[0] %>"><%= t[1] %></a><% }) %></div>
<% if(!rows.length){ %><div class="empty"><div class="e">🎟️</div>暂无优惠券</div><% } %>
<div class="grid g2" style="grid-template-columns:1fr 1fr"><% rows.forEach(c=>{ %><div class="coupon <%= c.state!=='unused'?'off':'' %>"><div class="l"><b><%= c.amount %></b><small><%= c.threshold?'满'+c.threshold+'可用':'无门槛' %></small></div><div class="r"><b><%= c.name %></b><span class="muted"><%= c.description %></span><span class="muted">有效期至 <%= c.expire_at.slice(0,10) %></span></div><% if(c.state==='unused'){ %><div class="act"><a class="btn primary sm" href="/products">去使用</a></div><% } %></div><% }) %></div></div></div>
