<div class="crumb"><a href="/">首页</a> › 活动专区</div>
<div class="flash-sale sk-page"><div class="hd"><h2>⚡ 活动专区</h2></div></div>
<div class="sk-body"><% if(!rows.length){ %><div class="empty">暂无活动</div><% } %>
<div class="grid"><% rows.forEach(s=>{ const pct=Math.round(s.sold/s.stock*100); %><a class="pcard" style="color:var(--ink)" href="/product/<%= s.product_id %>"><span class="ribbon"><%= s.live?'进行中':'即将开始' %></span><div class="pic"><img loading="lazy" decoding="async" src="<%= s.img %>"></div><div class="info"><div class="name"><%= s.name %></div><div class="meta"><span class="price"><big><%= s.price %></big><% if (showMkt(s.market_price, s.price)) { %><span class="mkt"><%= s.market_price %></span><% } %></span></div>
<div class="bar"><i style="width:<%= pct %>%"></i></div><div class="flex between"><span class="sales">活动进度 <%= pct %>%</span></div>
<span class="btn primary sm block mt"><%= s.live?(s.sold>=s.stock?'已售罄':'去看看'):'即将开始' %></span></div></a><% }) %></div></div>
