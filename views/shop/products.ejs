<div class="crumb"><a href="/">首页</a> › <%= title %> <span class="muted">(共 <%= pg.total %> 件商品)</span></div>
<div class="listing">
  <aside class="filters card">
    <h4>商品分类</h4>
    <a href="<%= qs(req,{cat:'',page:''}) %>" class="<%= !cat?'on':'' %>">全部分类</a>
    <% navCats.forEach(c=>{ %><a href="<%= qs(req,{cat:c.id,page:''}) %>" class="<%= String(cat)===String(c.id)||(curCat&&curCat.parent_id===c.id)?'on':'' %>"><%= c.icon %> <%= c.name %></a>
      <% if (curCat && (curCat.id===c.id||curCat.parent_id===c.id)) { subCats.forEach(s=>{ %><a style="padding-left:30px;font-size:13px" class="<%= String(cat)===String(s.id)?'on':'' %>" href="<%= qs(req,{cat:s.id,page:''}) %>">└ <%= s.name %></a><% }) } %>
    <% }) %>
    <h4>品牌</h4>
    <a href="<%= qs(req,{brand:'',page:''}) %>" class="<%= !brand?'on':'' %>">全部品牌</a>
    <% brands.forEach(b=>{ %><a href="<%= qs(req,{brand:b.id,page:''}) %>" class="<%= String(brand)===String(b.id)?'on':'' %>"><%= b.name %></a><% }) %>
    <h4>价格区间</h4>
    <form method="get" class="flex"><% ['q','cat','brand','sort'].forEach(k=>{ if(req.query[k]){ %><input type="hidden" name="<%= k %>" value="<%= req.query[k] %>"><% }}) %>
      <input type="number" name="min" value="<%= min %>" placeholder="最低" style="padding:6px"><span>-</span><input type="number" name="max" value="<%= max %>" placeholder="最高" style="padding:6px"></form>
    <button class="btn sm block mt" onclick="this.previousElementSibling.submit()">确定</button>
  </aside>
  <section>
    <div class="mfilter">
      <div class="chiprow">
        <a class="mchip <%= !cat?'on':'' %>" href="<%= qs(req,{cat:'',page:''}) %>">全部</a>
        <% navCats.forEach(c=>{ const con = String(cat)===String(c.id)||(curCat&&curCat.parent_id===c.id); %><a class="mchip <%= con?'on':'' %>" href="<%= qs(req,{cat:c.id,page:''}) %>"><%= c.icon %> <%= c.name %></a><% }) %>
      </div>
      <% if (curCat && subCats.length) { const pcid = curCat.parent_id || curCat.id; %>
      <div class="chiprow sub">
        <a class="mchip sm <%= String(cat)===String(pcid)?'on':'' %>" href="<%= qs(req,{cat:pcid,page:''}) %>">全部</a>
        <% subCats.forEach(s=>{ %><a class="mchip sm <%= String(cat)===String(s.id)?'on':'' %>" href="<%= qs(req,{cat:s.id,page:''}) %>"><%= s.name %></a><% }) %>
      </div>
      <% } %>
      <% const curBrand = brands.find(b=>String(b.id)===String(brand)); const priceTxt = (min!==''||max!=='') ? ('¥' + (min||0) + '-' + (max||'不限')) : ''; const fsum = [curBrand&&curBrand.name, priceTxt].filter(Boolean).join(' / '); %>
      <details class="mfold">
        <summary>筛选<% if (fsum) { %><span class="hl">· <%= fsum %></span><% } %><span class="muted">品牌 / 价格</span></summary>
        <div class="fbody">
          <div class="flabel">品牌</div>
          <div class="chipwrap"><a class="mchip sm <%= !brand?'on':'' %>" href="<%= qs(req,{brand:'',page:''}) %>">全部品牌</a><% brands.forEach(b=>{ %><a class="mchip sm <%= String(brand)===String(b.id)?'on':'' %>" href="<%= qs(req,{brand:b.id,page:''}) %>"><%= b.name %></a><% }) %></div>
          <div class="flabel">价格区间</div>
          <form method="get" class="pricef"><% ['q','cat','brand','sort'].forEach(k=>{ if(req.query[k]){ %><input type="hidden" name="<%= k %>" value="<%= req.query[k] %>"><% }}) %>
            <input type="number" name="min" value="<%= min %>" placeholder="最低价" inputmode="decimal"><span>-</span><input type="number" name="max" value="<%= max %>" placeholder="最高价" inputmode="decimal"><button class="btn sm primary">确定</button></form>
        </div>
      </details>
    </div>
    <form class="psearch" method="get" action="/products" role="search"><% if (cat) { %><input type="hidden" name="cat" value="<%= cat %>"><% } %><% if (sort) { %><input type="hidden" name="sort" value="<%= sort %>"><% } %><input type="search" name="q" value="<%= q %>" placeholder="在全部商品中搜索" enterkeyhint="search" maxlength="40" aria-label="搜索商品"><button class="btn primary sm">搜索</button></form>
    <div class="sortbar">
      <a class="<%= !sort?'on':'' %>" href="<%= qs(req,{sort:'',page:''}) %>">综合</a>
      <a class="<%= sort==='price_asc'||sort==='price_desc'?'on':'' %>" href="<%= qs(req,{sort:sort==='price_asc'?'price_desc':'price_asc',page:''}) %>">价格 <%= sort==='price_desc'?'↓':sort==='price_asc'?'↑':'↕' %></a>
      <a class="<%= sort==='sales'?'on':'' %>" href="<%= qs(req,{sort:'sales',page:''}) %>">销量</a>
      <a class="<%= sort==='new'?'on':'' %>" href="<%= qs(req,{sort:'new',page:''}) %>">新品</a>
    </div>
    <% if (!pg.rows.length) { %><div class="card empty"><div class="e">📦</div>暂无商品<% if (q||cat||brand||min!==''||max!=='') { %><br><br><a class="btn" href="/products">查看全部商品</a><% } %></div>
    <% } else { %><div class="grid g3 plist" style="grid-template-columns:repeat(3,1fr)" data-infinite data-page="<%= pg.page %>" data-pages="<%= pg.pages %>"><%- include('../partials/cards',{rows:pg.rows}) %></div><div class="pmore muted" data-more hidden>加载中…</div><% } %>
    <%- include('../partials/pager') %>
  </section>
</div>
<style>@media(max-width:900px){.listing .grid.g3{grid-template-columns:repeat(2,1fr)!important}}
.psearch{display:flex;gap:8px;margin-bottom:10px;min-width:0}.psearch input{flex:1;min-width:0;padding:8px 12px;border:1px solid var(--line);border-radius:999px}.pmore{text-align:center;padding:14px 0}
.plist{min-width:0}.plist .pcard{min-width:0}</style>
<script>(function(){var g=document.querySelector('[data-infinite]');if(!g||!('IntersectionObserver' in window)||!window.fetch)return;var page=+g.dataset.page,pages=+g.dataset.pages,busy=false,more=document.querySelector('[data-more]'),pager=document.querySelector('.pager');if(page>=pages)return;if(pager)pager.style.display='none';more.hidden=false;
var io=new IntersectionObserver(function(es){if(!es[0].isIntersecting||busy||page>=pages)return;busy=true;var u=new URL(location.href);u.searchParams.set('page',page+1);u.searchParams.set('partial','1');
fetch(u,{headers:{Accept:'application/json'},credentials:'same-origin'}).then(function(r){return r.json()}).then(function(d){g.insertAdjacentHTML('beforeend',d.html);page=d.page;pages=d.pages;busy=false;if(page>=pages){io.disconnect();more.textContent='没有更多了'}}).catch(function(){busy=false;io.disconnect();more.hidden=true;if(pager)pager.style.display=''})},{rootMargin:'600px 0px'});io.observe(more)})();</script>
