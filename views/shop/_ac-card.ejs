<%# 订单详情 / 支付成功:活动专区订单的邀请进度卡(数据来自 lib/ac.progress) %>
<%- include('_ac-style') %>
<div class="ac-card mb" id="acCard"><h3><%= ac.title %></h3>
  <div class="muted" style="font-size:12px">已计入 <b style="color:#2E9E5B"><%= p.counted %></b>/<%= p.need %> · <%= p.statusLabel %><% if (p.status==='open' || p.status==='frozen') { %> · 截止 <%= p.deadline %><% } %></div>
  <%- include('_ac-slots',{p}) %>
  <% if (p.status==='frozen') { %><div style="color:#B26B00;font-size:12px;margin-bottom:6px">好友退款，免单券已冻结，再邀 <%= p.left %> 位好友下单即可恢复</div><% } %>
  <% if (p.status==='open' || p.status==='frozen') { %><a class="ac-btn" href="/me/free#ac<%= p.id %>">去邀请</a><% } else if (p.status==='done') { %><a class="ac-btn" href="/me/coupons">去使用</a><% } %>
</div>
