<div class="crumb"><a href="/orders">我的订单</a> › <a href="/order/<%= o.id %>">订单详情</a> › 物流跟踪</div>
<div class="card">
  <% if (packages.length) { %><h3 style="margin-top:0">📦 共 <%= packages.length %> 个包裹</h3><%- include('../partials/packages', { packages }) %><% } else { %><div class="flex"><% if (items[0]) { %><img loading="lazy" decoding="async" src="<%= items[0].image %>" style="width:80px;height:80px;border-radius:10px;object-fit:cover" onerror="<%= U.IMG_FALLBACK %>"><% } %><div><b><%= o.express_company||'暂未发货' %></b><br>运单号:<%= o.tracking_no||'-' %> <% if(o.tracking_no){ %><% if (demo) { %><span class="muted">(模拟轨迹,非真实快递数据)</span><% } %><% } %></div></div><% } %>
  <ul class="timeline mt"><% traces.forEach(t=>{ %><li><%= t.text %><time><%= t.time %></time></li><% }) %></ul>
  <% if (o.status==='shipped' && !packages.some(p=>p.source!=='own')) { %><form method="post" action="/order/<%= o.id %>/logistics/simulate"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm">⏩ 模拟物流更新</button></form><% } %>
</div>
