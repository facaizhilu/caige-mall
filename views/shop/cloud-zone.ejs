<section class="card cz-zone"><% if(!pg.rows.length){ %><div class="cz-empty"><div class="cz-empty-icon"><%- include('../partials/ic',{icn:'box',isz:30}) %></div><b>商品陆续上架中，敬请期待</b><p>上架后将在此展示</p></div><% }else{ %><div class="cz-grid"><% pg.rows.forEach(p=>{ %><a class="cz-item" href="/cloud-zone/product/<%= p.id %>"><img loading="lazy" src="<%= U.firstImg(p.images) %>" alt="" onerror="<%= U.IMG_FALLBACK %>"><b><%= p.name %></b><span><%= money(p.price) %></span></a><% }) %></div><%- include('../partials/pager') %><% } %></section>
