<div class="crumb"><a href="/">首页</a> › 拼团专区</div>
<div class="card" style="background:linear-gradient(120deg,#9a3412,#fbbf24);color:#fff;margin-bottom:18px"><h2 style="margin:0">👥 拼团享低价</h2><p style="margin:4px 0 0">发起拼团并邀请好友,成团即发货;超时未成团自动全额退款</p></div>
<div class="grid"><% rows.forEach(g=>{ %><a class="pcard" href="/product/<%= g.product_id %>"><span class="ribbon"><%= g.size %>人团</span><div class="pic"><img src="<%= g.img %>"></div><div class="info"><div class="name"><%= g.name %></div><div class="meta"><span class="price"><big><%= g.price %></big><span class="mkt"><%= g.market_price %></span></span><span class="tag">拼团价</span></div><span class="btn primary sm block mt">去开团</span></div></a><% }) %></div>
<% if(open.length){ %><div class="sec"><div class="sec-h"><h2>正在拼团</h2></div><div class="card"><% open.forEach(g=>{ %><div class="flex between" style="padding:10px 0;border-bottom:1px dashed var(--line)"><span><b><%= g.nickname.slice(0,1) %>**</b> 发起:<%= g.pname %> · 拼团价 <span class="price"><%= g.price %></span> · 还差 <b style="color:var(--red)"><%= g.need-g.joined %></b> 人</span><span class="flex"><span class="cd" data-countdown="<%= g.expire_at %>"></span><a class="btn primary sm" href="/group/<%= g.id %>">去参团</a></span></div><% }) %></div></div><% } %>
