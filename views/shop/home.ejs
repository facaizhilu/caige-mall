<% const pic=(n,alt)=>'<picture><source type="image/webp" srcset="/static/img/home/'+n+'@2x.webp 2x,/static/img/home/'+n+'@3x.webp 3x"><img src="/static/img/home/'+n+'@2x.png" alt="'+(alt||'')+'" loading="lazy" decoding="async"></picture>'; %>
<div class="top">
  <% if (shop.announcement) { %><div class="ann"><%= shop.announcement %></div><% } %>
  <div class="head"><a class="brand" href="/" aria-label="首页"><span class="seal">财</span><span class="bn"><%= shop.shop_name %></span></a></div>
  <form class="search" action="/products" method="get" role="search"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg><input name="q" type="search" enterkeyhint="search" autocomplete="off" maxlength="40" aria-label="搜索商品" placeholder="搜索你想要的商品"><button>搜索</button></form>
  <% if (flash) { %><div class="flash <%= flash.type %>"><%= flash.msg %></div><% } %>
  <% if (user) { %>
  <div class="hero"><small>欢迎回来</small><h2><%= user.nickname %></h2><p>领取可用优惠券,下单更划算</p><a class="btn" href="/coupons">去领券 ›</a></div>
  <% } else { %>
  <div class="hero"><small>新人专享</small><h2>新人注册有礼</h2><p>注册即送<% if (regPts) { %> <%= regPts %> 积分<% } %><% if (regPts && newbieCoupon) { %>及<% } %><% if (newbieCoupon) { %>新人优惠券<% } %><% if (!regPts && !newbieCoupon) { %>会员积分与权益<% } %></p><a class="btn" href="/register">立即注册 ›</a></div>
  <% } %>
  <nav class="ents" aria-label="快捷入口">
    <a class="ent" href="/me/points"><b><%- pic('icon-signin') %></b>每日签到</a>
    <a class="ent" href="/points-mall"><b><%- pic('icon-points') %></b>积分商城</a>
    <a class="ent" href="/orders"><b><%- pic('icon-orders') %></b>我的订单</a>
    <a class="ent" href="/me/invite"><b><%- pic('icon-invite') %></b>邀请好友</a>
    <a class="ent" href="/me/cloud"><b><%- pic('icon-vip') %></b>云商会员</a>
  </nav>
</div>
<h2 class="orn"><svg width="70" height="14" viewBox="0 0 70 14" aria-hidden="true"><path d="M0 7h44" stroke="#c99236" stroke-width="1"/><path d="M46 7q5-6 10 0q5 6 10 0" fill="none" stroke="#c99236" stroke-width="1.5"/><circle cx="68" cy="7" r="2" fill="#c99236"/></svg>精选专区<svg style="transform:scaleX(-1)" width="70" height="14" viewBox="0 0 70 14" aria-hidden="true"><path d="M0 7h44" stroke="#c99236" stroke-width="1"/><path d="M46 7q5-6 10 0q5 6 10 0" fill="none" stroke="#c99236" stroke-width="1.5"/><circle cx="68" cy="7" r="2" fill="#c99236"/></svg></h2>
<div class="bento">
  <a class="bc b0" href="/products"><h3>全部商品</h3><p>精选好物 品质之选</p><span>进入专区 ›</span><%- pic('card-goods') %></a>
  <a class="bc b1" href="/seckill"><h3>活动专区</h3><p>主题活动 持续上新</p><%- pic('card-event') %></a>
  <a class="bc b3" href="/me/cloud"><h3>云商卡</h3><p>会员权益 专属服务</p><%- pic('card-yunshang') %></a>
</div>
<div class="wide"><a class="bc" href="/points-mall"><h3>积分专区</h3><p>积分兑换 好礼相送</p><span>去兑换 ›</span><%- pic('card-points') %></a></div>
<div class="svc"><div><i>退</i>7天无理由退货（鲜活易腐商品除外）</div><div><i>正</i>正品保障</div><div><i>服</i>客服售后</div></div>
<footer class="zq-foot"><nav><a href="/help">帮助中心</a><a href="/service">联系客服</a><a href="/terms">用户协议</a><a href="/privacy">隐私政策</a></nav><div>© 2026 <%= shop.shop_name %><% if (shop.icp) { %> · <%= shop.icp %><% } %> · 本站为演示站点,支付为模拟支付</div></footer>
<nav class="tab" aria-label="底部导航">
  <a class="on" href="/" aria-current="page"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true"><path d="M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z"/></svg><span>首页</span></a>
  <a href="/products"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true"><rect x="3" y="3" width="7.5" height="7.5" rx="2"/><rect x="13.5" y="3" width="7.5" height="7.5" rx="3.75"/><rect x="3" y="13.5" width="7.5" height="7.5" rx="2"/><rect x="13.5" y="13.5" width="7.5" height="7.5" rx="2"/></svg><span>分类</span></a>
  <a href="/cart"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true"><path d="M3 4h2.5l2.2 11h11l2-8H7"/><circle cx="9" cy="19.5" r="1.4"/><circle cx="17" cy="19.5" r="1.4"/></svg><span>购物车</span><% if (cartCount) { %><i class="badge"><%= cartCount %></i><% } %></a>
  <a href="<%= user?'/me':'/login' %>"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c1-4.5 4.5-6.5 8-6.5s7 2 8 6.5"/></svg><span>我的</span></a>
</nav>
