<% const pic=(n,alt)=>'<picture><source type="image/webp" srcset="/static/img/home/'+n+'@2x.webp 2x,/static/img/home/'+n+'@3x.webp 3x"><img src="/static/img/home/'+n+'@2x.png" alt="'+(alt||'')+'" decoding="async"></picture>'; %>
<div class="top">
  <% if (shop.announcement) { %><a class="ann" href="/notices" title="<%= shop.announcement %>"><span><%= shop.announcement %></span></a><% } %>
  <%- include('../partials/header') %>
  <% if (flash) { %><div class="flash <%= flash.type %>"><%= flash.msg %></div><% } %>
  <% if (banners.length) { %>
  <div class="hero bnr" role="region" aria-roledescription="carousel" aria-label="活动横幅"<%- banners.length > 1 ? ' data-n="' + banners.length + '"' : '' %>>
    <div class="bnr-t" aria-live="off">
    <% banners.forEach(function (b, i) { const tag = b.link ? 'a' : 'div'; %>
      <<%= tag %> class="bnr-s<%= i ? ' off' : '' %>"<% if (b.link) { %> href="<%= b.link %>"<% } %> style="background:linear-gradient(120deg,<%= b.bg1 %>,<%= b.bg2 %>)" role="group" aria-roledescription="slide" aria-label="<%= i + 1 %> / <%= banners.length %>"<%- i ? ' aria-hidden="true" tabindex="-1"' : '' %>>
        <% if (b.image) { %><img class="bnr-i" src="<%= b.image %>" alt="" width="750" height="280" decoding="async"<%- i ? ' loading="lazy"' : ' fetchpriority="high"' %>><% } %>
        <h2><%= b.title %></h2><% if (b.subtitle) { %><p><%= b.subtitle %></p><% } %><% if (b.link) { %><span class="btn">去看看 ›</span><% } %>
      </<%= tag %>>
    <% }) %>
    </div>
    <% if (banners.length > 1) { %><div class="bnr-d"><% banners.forEach(function (b, i) { %><button type="button"<%- i ? '' : ' class="on" aria-current="true"' %> aria-label="第 <%= i + 1 %> 张"></button><% }) %></div><% } %>
  </div>
  <% } else { %>
  <% if (user) { %>
  <a class="hero" href="/coupons"><small>欢迎回来</small><h2><%= user.nickname %></h2><p>领取可用优惠券,下单更划算</p><span class="btn">去领券 ›</span></a>
  <% } else { %>
  <a class="hero" href="/register"><small>新人专享</small><h2>新人注册有礼</h2><p>注册即送<% if (regPts) { %> <%= regPts %> 积分<% } %><% if (regPts && newbieCoupon) { %>及<% } %><% if (newbieCoupon) { %>新人优惠券<% } %><% if (!regPts && !newbieCoupon) { %>会员积分与权益<% } %></p><span class="btn">立即注册 ›</span></a>
  <% } %>
  <% } %>
  <nav class="ents" aria-label="快捷入口">
    <a class="ent" href="/me/points"><b><%- pic('icon-signin') %></b>每日签到</a>
    <a class="ent" href="/points-mall"><b><%- pic('icon-points') %></b>积分专区</a>
    <a class="ent" href="/orders"><b><%- pic('icon-orders') %></b>我的订单</a>
    <a class="ent" href="/me/invite"><b><%- pic('icon-invite') %></b>邀请好友</a>
    <a class="ent" href="/me/cloud"><b><%- pic('icon-vip') %></b>云商会员</a>
  </nav>
</div>
<nav class="zones" aria-label="精选专区">
  <a class="bc b0" href="/products"><h3>全部商品</h3><p>数码鲜果</p><%- pic('card-goods') %></a>
  <a class="bc b1" href="/activity"><h3>活动专区</h3><p>持续上新</p><%- pic('card-event') %></a>
  <a class="bc b2" href="/points-mall"><h3>积分专区</h3><p>好礼兑换</p><%- pic('card-points') %></a>
  <a class="bc b3" href="/me/cloud"><h3>云商卡</h3><p>会员权益</p><%- pic('card-yunshang') %></a>
</nav>
<div class="svc" aria-label="服务保障"><div><i>退</i>7天无理由(鲜活易腐除外)</div><div><i>正</i>正品保障</div><div><i>服</i>客服售后</div></div>
<section class="picks" aria-labelledby="picks-t">
  <div class="pk-h"><h3 id="picks-t">好物精选</h3><a href="/products">更多 ›</a></div>
  <div class="pk-g">
  <% if (picks.length) { picks.forEach(function (g, i) { %>
    <a class="pk" href="/product/<%= g.id %>"><span class="pk-i"><img src="<%= g.img %>" alt="" width="200" height="200"<%- i < 3 ? '' : ' loading="lazy"' %> decoding="async" onerror="<%= IMG_FALLBACK %>"></span><span class="pk-n"><%= g.name %></span><span class="pk-p">¥<%= Number(g.price).toFixed(2) %></span></a>
  <% }) } else { for (let i = 0; i < 6; i++) { %>
    <div class="pk ph" aria-hidden="true"><span class="pk-i"><img src="<%= PH %>" alt="" width="200" height="200" decoding="async"></span><span class="pk-n">示例商品</span></div>
  <% } } %>
  </div>
</section>
<footer class="zq-foot"><div class="icp">© 2026 <%= shop.shop_name %><% if (shop.icp) { %> · <%= shop.icp %><% } %></div></footer>
<%- include('../partials/tabbar') %>
