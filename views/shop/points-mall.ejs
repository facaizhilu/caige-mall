<div class="crumb"><a href="/">首页</a> › 积分商城</div>
<div class="card" style="background:linear-gradient(120deg,#f59e0b,#d4202a);color:#fff;margin-bottom:18px" ><div class="flex between wrapf"><div><h2 style="margin:0">🎁 积分商城</h2><p style="margin:4px 0 0">签到、购物赚积分,免费兑好礼</p></div><div class="right"><% if (user) { %>我的积分 <b style="font-size:30px"><%= user.points %></b><br><a href="/me/points" style="color:#ffe9b0">去签到赚积分 ›</a><% } else { %><a class="btn" href="/login?next=/points-mall">登录查看积分</a><% } %></div></div></div>
<div class="grid"><% goods.forEach(g=>{ %><div class="pcard"><div class="pic"><img src="<%= g.image %>"></div><div class="info"><div class="name"><%= g.name %></div><div class="sub"><%= g.description %></div><div class="meta"><b style="color:var(--gold-d);font-size:18px"><%= g.points %> <small>积分</small></b><span class="sales">剩余 <%= g.stock %></span></div>
<form method="post" action="/points-mall/<%= g.id %>/exchange" data-confirm="确定使用 <%= g.points %> 积分兑换「<%= g.name %>」?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn gold block mt" <%= g.stock<=0?'disabled':'' %>><%= g.stock<=0?'已兑完':'立即兑换' %></button></form></div></div><% }) %></div>
