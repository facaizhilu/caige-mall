<div class="crumb"><a href="/">首页</a> › 积分专区</div>
<style>
.pm-head{display:flex;align-items:center;gap:6px;flex-wrap:nowrap;min-height:44px;padding:0 14px;margin-bottom:12px;border-radius:12px;background:radial-gradient(140% 160% at 20% 0%,#d63a2c,#9e1712 60%,#6e0d0b);color:#FBE3B0;font-size:14px;white-space:nowrap;overflow:hidden;box-shadow:inset 0 -2px 0 #e9b84f}.pm-head b{color:#ffe08a;font-size:18px}.pm-head a{color:#ffe08a;font-weight:600}.pm-head .pm-dot{opacity:.7}.pm-head>span:first-child{min-width:0;overflow:hidden;text-overflow:ellipsis}
.pcard .pic{background:#faf5ea}
.btn.gold{background:linear-gradient(135deg,#e8c26a,#c48f2f)!important;color:#5a0d0d!important;border-color:transparent!important}.pm-ptag{background:linear-gradient(135deg,#d63a2c,#9e1712)!important;color:#FBE3B0!important}
.pm-ptag{display:inline-block;background:linear-gradient(120deg,#f5c242,#d99a0b);color:#fff;font-weight:700;border-radius:999px;padding:2px 10px;font-size:15px;line-height:1.5;white-space:nowrap}
.pm-ship{display:inline-block;border:1px solid #f0b429;color:#b7791f;border-radius:4px;padding:0 4px;font-size:12px;line-height:18px;margin-left:4px;white-space:nowrap}
.pm-left{font-size:12px;color:#888}
.tag.demo{font-size:12px}
.pcard.soldout .pic img{filter:grayscale(1);opacity:.6}
.pm-so{position:absolute;left:8px;top:8px;background:rgba(0,0,0,.6);color:#fff;font-size:12px;border-radius:4px;padding:2px 6px;z-index:1}
@media(max-width:430px){.pm-ptag{font-size:13px;padding:1px 8px}}
</style>
<div class="pm-head"><% if (user) { %><span>我的积分 <b><%= user.points %></b></span><span class="pm-dot">·</span><a href="/me/points">去签到 ›</a><% } else { %><span>签到、购物赚积分 · 兑换包邮</span><a href="/login?next=/points-mall">登录查看积分 ›</a><% } %></div>
<div class="grid"><% goods.forEach(g=>{ %><div class="pcard<%= g.soldOut?' soldout':'' %>" style="position:relative"><% if (g.soldOut) { %><span class="pm-so">已兑完</span><% } %><a class="pic" href="/points-mall/<%= g.id %>"><img loading="lazy" decoding="async" src="<%= g.image %>" alt="<%= g.name %>"></a><div class="info"><div class="name"><a href="/points-mall/<%= g.id %>"><%= g.name %></a></div>
<div class="meta"><span><span class="pm-ptag"><%= g.pp.label %></span><% if (g.type==='goods') { %><span class="pm-ship">包邮</span><% } %></span></div>
<% if (g.per_user_limit > 0) { %><div class="pm-left">每人限兑 <%= g.per_user_limit %> 件<% if (user) { %> · 还可兑 <%= g.left %> 件<% } %></div><% } %>
<% if (g.soldOut) { %><button class="btn block mt" disabled>已兑完</button><% } else { %><a class="btn gold block mt" href="/points-mall/<%= g.id %>"><%= g.pp.mode==='points'?'立即兑换':'立即购买' %></a><% } %></div></div><% }) %></div>
