<div class="card auth">
  <h2>欢迎登录 <%= shop.shop_name %></h2>
  <div class="tabs"><a href="#" id="t1" class="<%= tab==='pwd'?'on':'' %>" onclick="sw('pwd');return false">密码登录</a><a href="#" id="t2" class="<%= tab==='sms'?'on':'' %>" onclick="sw('sms');return false">短信验证码登录</a></div>
  <form method="post" action="/login" id="f1" class="<%= tab==='pwd'?'':'hide' %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="next" value="<%= next %>">
    <div class="form-row"><label>手机号</label><input type="tel" name="phone" maxlength="11" placeholder="请输入 11 位手机号" value="<%= phone %>" required pattern="1[3-9]\d{9}"></div>
    <div class="form-row"><label>密码</label><input type="password" name="password" placeholder="请输入密码" required></div>
    <button class="btn primary lg block">登 录</button></form>
  <form method="post" action="/login/sms" id="f2" class="<%= tab==='sms'?'':'hide' %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="next" value="<%= next %>">
    <div class="form-row"><label>手机号</label><input type="tel" name="phone" id="sp" maxlength="11" placeholder="未注册手机号将自动注册" value="<%= phone %>" required></div>
    <div class="form-row"><label>验证码</label><div class="flex"><input name="code" maxlength="6" placeholder="6 位验证码" required><button type="button" class="btn" id="sendbtn" style="flex:none">获取验证码</button></div><div class="sim mt hide" id="demo"></div><div class="help">演示环境:不会真实发送短信,验证码会直接显示在此处</div></div>
    <button class="btn primary lg block">登录 / 注册</button></form>
  <div class="flex between mt"><a href="/register">立即注册</a><span class="muted">演示账号:13800000001 / 123456</span></div>
</div>
<script>
function sw(t){f1.classList.toggle('hide',t!=='pwd');f2.classList.toggle('hide',t!=='sms');t1.classList.toggle('on',t==='pwd');t2.classList.toggle('on',t==='sms')}
sendbtn.onclick=function(){postJSON('/sms/send',{phone:sp.value,purpose:'login'}).then(function(r){toast(r.msg);if(r.ok){demo.classList.remove('hide');demo.innerHTML='【模拟短信】您的验证码是 <b>'+r.demoCode+'</b>,5分钟内有效';var n=30;sendbtn.disabled=true;var t=setInterval(function(){sendbtn.textContent=(--n)+'s 后重发';if(n<=0){clearInterval(t);sendbtn.disabled=false;sendbtn.textContent='获取验证码'}},1000)}})};
</script>
