<%# 「我的」方案A:弧形渐变头(头像/昵称/邀请码/等级 + 签到)→ 我的订单 → 云商会员 → 成长值 → 我的积分 → 常用功能 → 帮助/协议/设置(退出登录在最后)→ 推荐商品 %>
<% const ic = (n, z) => include('../partials/ic', { icn: n, isz: z || 24 }); const dot = '<i class="gd"></i>';
   const HS = (id) => '<svg class="kf-ic" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 14v-2a8 8 0 0 1 16 0v2"/><rect x="3.5" y="13" width="4" height="6" rx="1.5"/><rect x="16.5" y="13" width="4" height="6" rx="1.5"/><path d="M18.5 19c0 1.5-2 2.5-5 2.5"/></svg>'; %>
<div class="mepage">
<div class="me-hd"><i class="gh-c1"></i><i class="gh-c2"></i>
  <div class="me-tools"><% if (!guest) { %><a href="/me/profile" aria-label="个人资料"><%- ic('edit', 22) %></a><a href="/me/settings" aria-label="设置"><%- ic('gear', 22) %></a><% } %></div>
<% if (guest) { %>
  <div class="mecard guest"><div class="avatar"><img src="/static/img/mark-green.svg?v=1" alt="" width="46" height="46"></div><div class="mc-info"><a class="mc-name" href="/login?next=/me">登录/注册</a><div class="mc-sub">登录后查看订单、积分与会员权益</div></div><div class="mc-act"><a class="mc-sign" href="/login?next=/me">登录/注册</a></div></div>
<% } else { %>
  <div class="mecard"><div class="avatar"><img src="/static/img/mark-green.svg?v=1" alt="<%= user.nickname.slice(0,1) %>" width="46" height="46"></div>
    <div class="mc-info"><div class="mc-name"><%= user.nickname %></div><div class="mc-sub"><span class="nw"><%= U.maskPhone(user.phone) %></span> · <span class="nw">邀请码 <%= user.invite_code %></span></div><div class="mc-tags"><span class="lvtag"><%- include('../partials/ic', { icn: 'crown', isz: 12 }) %><%= user.level_name %></span><% if (cloudOn) { %><span class="lvtag gold">云商会员</span><% } %></div></div>
    <form method="post" action="/me/signin" class="me-signin"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="mc-sign" <%= signed?'disabled':'' %>><%= signed?'已签到':'签到' %></button></form></div>
<% } %>
</div>
<div class="me-body">
  <div class="card me-sec me-ord"><div class="sec-h"><h2>我的订单</h2><a href="/orders">全部订单 <%- include('../partials/ic', { icn: 'chev', isz: 13 }) %></a></div>
    <div class="me-grid g5">
      <a href="/orders?status=unpaid"><span><%- ic('wallet', 26) %></span>待支付<% if (!guest && cnt.unpaid) { %><b class="qbadge"><%= cnt.unpaid %></b><% } %></a>
      <a href="/orders?status=paid"><span><%- ic('box', 26) %></span>待发货<% if (!guest && cnt.paid) { %><b class="qbadge"><%= cnt.paid %></b><% } %></a>
      <a href="/orders?status=shipped"><span><%- ic('truck', 26) %></span>待收货<% if (!guest && cnt.shipped) { %><b class="qbadge"><%= cnt.shipped %></b><% } %></a>
      <a href="/orders?status=completed"><span><%- ic('check', 26) %></span>已完成</a>
      <a href="/aftersales"><span><%- ic('return', 26) %></span>退换/售后<% if (!guest && stats.as) { %><b class="qbadge"><%= stats.as %></b><% } %></a>
    </div>
  </div>
  <a class="me-cloud" href="/me/cloud"><span class="mcl-i"><%- ic('card', 22) %></span><span class="mcl-t"><b>云商会员</b><small><%- !guest && cloudOn ? '已开通 · 享云商会员价' : '专享云商会员价 · <span class="nw">联系客服办理</span>' %></small></span><span class="mcl-b"><%= !guest && cloudOn ? '查看' : '去了解' %></span></a>
  <% if (!guest) { const lo = prev ? prev.min_growth : 0, pct = next ? Math.max(0, Math.min(100, Math.round((user.growth - lo) * 100 / Math.max(1, next.min_growth - lo)))) : 100; %>
  <a class="card me-grow" href="/me/levels"><span class="mg-t"><b>成长值 <%= user.growth %></b><small class="mc-grow"><% if (next) { %>再 <%= next.min_growth-user.growth %> 升级「<%= next.name %>」<% } else { %>已是最高等级<% } %></small></span><span class="mg-bar"><i style="width:<%= pct %>%"></i></span><span class="mg-l">会员等级<%- include('../partials/ic', { icn: 'chev', isz: 13 }) %></span></a>
  <a class="card me-pts" href="/me/points"><span>积分数量</span><b><%= user.points %></b></a>
  <% } else { %>
  <a class="card me-pts" href="/login?next=/me/points"><span>积分数量</span><b>登录查看</b></a>
  <% } %>
  <div class="card me-sec me-fn"><div class="sec-h vh"><h2>常用功能</h2></div>
    <div class="me-grid g4">
      <% if (!guest) { %><a href="/me/points"><span><%- ic('cal') %><%- dot %></span><%= signed?'今日已签':'每日签到' %></a><% } else { %><a href="/login?next=/me/points"><span><%- ic('cal') %><%- dot %></span>每日签到</a><% } %>
      <a href="/points-mall"><span><%- ic('coin') %><%- dot %></span>积分专区</a>
      <a href="/me/coupons"><span><%- ic('ticket') %><%- dot %></span>优惠券<% if (!guest && stats.coupons) { %><b class="qbadge"><%= stats.coupons %></b><% } %></a>
      <a href="/me/invite"><span><%- ic('share') %><%- dot %></span>我的推广</a>
      <a href="/me/addresses"><span><%- ic('pin') %><%- dot %></span>收货地址</a>
      <a href="/me/favorites"><span><%- ic('heart') %><%- dot %></span>我的收藏</a>
      <%# 小程序端:此入口改用 <button open-type="contact"> 打开微信原生客服 %><a class="me-kf" data-mp-open-type="contact" href="/service"><span><%- HS('kfg') %><%- dot %></span>在线客服</a>
      <a href="/me/reviews"><span><%- ic('msg') %><%- dot %></span>我的评价</a>
      <a href="/me/cloud"><span><%- ic('crown') %><%- dot %></span>云商会员</a>
    </div>
  </div>
  <div class="card me-sec me-help"><div class="setlist"><a href="/help">帮助中心<span class="muted">›</span></a><a href="/article/<%= aboutId %>">关于我们<span class="muted">›</span></a><a href="/points-rules">积分规则<span class="muted">›</span></a><a href="/privacy">隐私政策<span class="muted">›</span></a><a href="/terms">用户协议<span class="muted">›</span></a><% if (!guest) { %><a href="/me/settings">设置<span class="muted">›</span></a><% } %></div>
  <% if (!guest) { %><form method="post" action="/logout" class="me-logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button>退出登录</button></form><% } %></div>
  <% if (recs && recs.length) { %><section class="me-recs"><h2 class="rt"><span class="sl"><b></b><b></b></span>推荐商品<span class="sl"><b></b><b></b></span></h2>
    <div class="pk-g"><% recs.forEach(function (g) { const pr = Number(g.price).toFixed(2).split('.'); %><a class="pk" href="/product/<%= g.id %>"><span class="pk-i"><img src="<%= g.img %>" alt="" width="200" height="200" loading="lazy" decoding="async" onerror="<%= U.IMG_FALLBACK %>"></span><span class="pk-n"><%= g.name %></span><span class="pk-b"><span class="pk-p">¥<%= pr[0] %><small>.<%= pr[1] %></small></span><i class="pk-add" aria-hidden="true"><%- include('../partials/ic', { icn: 'plus', isz: 14 }) %></i></span></a><% }) %></div></section><% } %>
  <p class="me-legal"><a href="/terms">用户协议</a><i>|</i><a href="/privacy">隐私政策</a></p>
</div>
</div>
