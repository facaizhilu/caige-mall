<div class="me"><%- include("_menu",{cur:""}) %><div>
  <div class="mehead">
    <div class="avatar"><%= user.nickname.slice(0,1) %></div>
    <div style="flex:1"><div style="font-size:20px;font-weight:700"><%= user.nickname %><span class="lvtag">💎 <%= user.level_name %></span></div>
      <div style="opacity:.9">手机:<%= U.maskPhone(user.phone) %> · 邀请码 <%= user.invite_code %></div>
      <% if (next) { %><div class="progress"><i style="width:<%= Math.min(100,Math.round(user.growth/next.min_growth*100)) %>%"></i></div><div style="font-size:12px;opacity:.9">成长值 <%= user.growth %> / <%= next.min_growth %>,再 <%= next.min_growth-user.growth %> 成长值升级「<%= next.name %>」</div><% } else { %><div style="font-size:12px">已是最高等级 · 成长值 <%= user.growth %></div><% } %></div>
    <form method="post" action="/me/signin"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn" <%= signed?'disabled':'' %>><%= signed?'✔ 今日已签到':'📅 每日签到' %></button></form>
  </div>
  <div class="stats stats-4">
    <a class="stat" href="/me/points"><b><%= user.points %></b><span>积分</span></a>
    <a class="stat" href="/me/cloud#redeem"><b>兑</b><span>积分兑换</span></a>
    <a class="stat" href="/me/coupons"><b><%= stats.coupons %></b><span>优惠券</span></a>
    <a class="stat" href="/me/favorites"><b><%= stats.favs %></b><span>收藏</span></a>
  </div>
  <a class="card redeem-banner" href="/me/cloud#redeem"><b>积分兑换</b><span class="muted">提交兑换申请 · 后台审核后登记权益</span><span class="go">去兑换 ›</span></a>
  <div class="card"><div class="sec-h"><h2>我的订单</h2><a href="/orders">全部订单 ›</a></div>
    <div class="quick" style="margin-top:0"><a href="/orders?status=unpaid" style="box-shadow:none;background:#fafafc"><span>💳</span>待付款 <% if(cnt.unpaid){ %><b class="qbadge"><%= cnt.unpaid %></b><% } %></a><a href="/orders?status=paid" style="box-shadow:none;background:#fafafc"><span>📦</span>待发货 <% if(cnt.paid){ %><b class="qbadge"><%= cnt.paid %></b><% } %></a><a href="/orders?status=shipped" style="box-shadow:none;background:#fafafc"><span>🚚</span>待收货 <% if(cnt.shipped){ %><b class="qbadge"><%= cnt.shipped %></b><% } %></a><a href="/orders?status=completed" style="box-shadow:none;background:#fafafc"><span>✅</span>已完成</a><a href="/aftersales" style="box-shadow:none;background:#fafafc"><span>🔧</span>退款/售后 <% if(stats.as){ %><b class="qbadge"><%= stats.as %></b><% } %></a></div>
    <% recent.forEach(o=>{ %><div class="ocard mt" style="box-shadow:none;border:1px solid var(--line)"><div class="oh"><span><%= o.created_at %> · <%= o.order_no %></span><span class="os <%= o.status %>"><%= ORDER_STATUS[o.status] %></span></div><div class="ob"><div><% o.items.slice(0,2).forEach(i=>{ %><div class="oi"><img loading="lazy" decoding="async" src="<%= i.image %>"><span><%= i.name %></span></div><% }) %></div><a class="btn sm" href="/order/<%= o.id %>">查看</a></div></div><% }) %>
  </div>
  <div class="grid g2 mt me-links"><a class="card" href="/me/cloud"><b>💎 云商卡</b><br><span class="muted">开通会员权益 · 每日返积分</span></a><a class="card" href="/me/cloud#redeem"><b>💱 积分兑换</b><br><span class="muted">申请兑换 · 后台审核</span></a><a class="card" href="/me/cloud-fans"><b>👥 我的云粉</b><br><span class="muted">直推业绩 · 推三返一</span></a><a class="card" href="/me/referral"><b>🔗 邀请好友</b><br><span class="muted">分享邀请码</span></a></div>
</div></div>
