<div class="card auth" style="max-width:560px"><h2>👥 参与拼团</h2>
<div class="flex"><img loading="lazy" decoding="async" src="<%= img %>" style="width:96px;height:96px;border-radius:10px;object-fit:cover"><div><b><%= p.name %></b><br><span class="price"><big><%= gb.price %></big></span> <% if (showMkt(p.market_price, gb.price)) { %><span class="mkt"><%= p.market_price %></span><% } %></div></div>
<p class="mt">发起人:<b><%= g.nickname.slice(0,1) %>**</b> · <%= g.need %> 人成团 · 已参团 <b><%= members.length %></b> 人 · <% if(g.status==='open'&&!expired){ %><%= g.expire_at.slice(5,16) %> 截止<% } else { %><span class="tag"><%= {success:'已成团',failed:'拼团失败',open:'已过期'}[g.status] %></span><% } %></p>
<p>团员:<% members.forEach(m=>{ %><span class="tag gold"><%= String(m.nickname||'').slice(0,1) %>**</span><% }) %></p>
<% if(g.status==='open'&&!expired&&g.joined<g.need){ %>
  <% if(user){ %><form method="post" action="/checkout"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="sku_id" value="<%= gb.sku_id %>"><input type="hidden" name="qty" value="1"><input type="hidden" name="promo_type" value="group"><input type="hidden" name="promo_id" value="<%= gb.id %>"><input type="hidden" name="group_id" value="<%= g.id %>"><% if (!noReason) { %><label class="agree no7-ack"><input type="checkbox" name="no7_ok" value="1" required> 本商品不支持7天无理由退货,我已知晓</label><% } %><button class="btn primary lg block">立即参团 ¥<%= gb.price %></button></form><% } else { %><a class="btn primary lg block" href="/login?next=/group/<%= g.id %>">登录后参团</a><% } %>
<% } else { %><a class="btn block" href="/product/<%= p.id %>">查看商品 / 自己开团</a><% } %></div>
