<div class="crumb"><a href="/">首页</a> › <% if (category&&category.parent_name) { %><a href="/products?cat=<%= category.parent_cid %>"><%= category.parent_name %></a> › <% } %><% if (category) { %><a href="/products?cat=<%= category.id %>"><%= category.name %></a> › <% } %><%= p.name %></div>
<div class="card pd">
  <div class="gallery"><div class="main"><img id="mainImg" src="<%= images[0] || U.PLACEHOLDER %>" alt="" onerror="<%= U.IMG_FALLBACK %>"></div>
    <div class="thumbs"><% images.forEach((im,i)=>{ %><img loading="lazy" decoding="async" src="<%= im %>" onerror="<%= U.IMG_FALLBACK %>" class="<%= i===0?'on':'' %>" onclick="document.getElementById('mainImg').src=this.src;document.querySelectorAll('.thumbs img').forEach(x=>x.classList.remove('on'));this.classList.add('on')"><% }) %></div></div>
  <div>
    <h1><%= p.name %></h1>
    <div class="subt"><%= p.subtitle %></div>
    <div class="pricebox">
      <% if (seckill) { %><div class="flex between" style="margin-bottom:6px"><span class="tag" style="background:var(--red);color:#fff">⚡ 活动专区</span><span class="muted"><%= seckill.live?'活动进行中':'活动即将开始' %></span></div><% } %>
      <span class="price"><big id="price"><%= (seckill&&seckill.live?seckill.price:p.price) %></big></span>
      <% if (!p.supplier && showMkt(p.market_price, p.price)) { %><span class="mkt"><%= p.market_price %></span><% } %>
      <% if (seckill && seckill.live) { %><span class="muted"> 活动价,每人限购 <%= seckill.limit_per_user %> 件</span><% } %>
      <% if (seckill && !seckill.live) { %><span class="muted sk-pre"> 活动价 <b style="color:var(--red)">¥<%= seckill.price %></b>,<%= seckill.start_at.slice(5,16) %> 开始,每人限购 <%= seckill.limit_per_user %> 件</span><% } %>
      <% if (cloudOffer && !seckill) { %><div class="cloud-price" style="font-size:13px;margin-top:4px;color:var(--gold-d)">💎 云商会员价 <%= cloudOffer.zhe %>折 <b>¥<span id="cloudPrice" data-rate="<%= cloudOffer.rate %>"><%= (Math.round(p.price*cloudOffer.rate)/100).toFixed(2) %></span></b><span class="muted" style="font-size:12px">,结算时自动优惠</span></div><% } else if (user && user.level_discount<100 && !seckill) { %><div style="font-size:12px;margin-top:4px;color:var(--gold-d)">💎 <%= user.level_name %>专享 <%= user.level_discount/10 %> 折,结算时自动优惠</div><% } %>
      <% if (cloudRange && !seckill) { %><div class="muted" style="font-size:12px;margin-top:4px">云商卡会员享<%= cloudRange %>折</div><% } %>
    </div>
    <dl class="kv pd-kv" style="margin:12px 0"><% const supBrand = p.supplier ? (p.supplier_brand || (brand && brand.name) || '') : ''; if (supBrand) { %><dt>品牌</dt><dd class="pd-brand"><%= supBrand %></dd><% } %><dt>配送</dt><dd><% if (p.ship_from) { %><span class="<%= p.supplier ? 'sup-ship' : '' %>"><%= p.ship_from %></span><% } else if (p.supplier) { %><span class="sup-ship">供应商发货</span><% } else { %><%= shop.ship_from || '海口发货' %><% } %></dd>
      <dt>运费</dt><dd class="freight"><% if (freight) { %><b class="<%= freight.free ? 'free' : '' %>"><%= freight.text %></b><% } %> <a class="muted" href="/help">运费规则 ›</a><div class="muted" style="font-size:12px">实际运费在结算页按收货地址计算</div></dd>
      <dt>服务</dt><dd><span class="tag green">正品保证</span><span class="tag green">7天无理由退货</span><% if (p.supplier) { %><span class="tag gray">由供应商发货</span><% } else { %><span class="tag green">极速发货</span><% } %></dd>
      <% if (shop.show_sales === '1' && +p.sales > 0) { %><dt>销量</dt><dd>已售 <%= p.sales %> 件 · <%= rateText %></dd><% } else { %><dt>评价</dt><dd><%= rateText %></dd><% } %></dl>
    <% specs.forEach((s,si)=>{ %><div class="opt"><label><%= s.name %></label><div class="opts" data-spec="<%= s.name %>"><% s.values.forEach((v,vi)=>{ %><span class="chip<%= vi===0?' on':'' %>" data-v="<%= v %>"><%= v %></span><% }) %></div></div><% }) %>
    <div class="opt"><label>数量</label><div class="flex"><div class="qty"><button type="button" id="qm">−</button><input id="qty" value="1" inputmode="numeric"><button type="button" id="qp">+</button></div><span class="muted">库存 <b id="stock">-</b> 件</span></div></div>
    <% const canGroup = groupbuy, canSk = seckill && seckill.live; %>
    <% const dis = ''; %>
    <div class="flex wrapf mt pd-bar">
      <%# 小程序端:改为 <button open-type="contact"> 使用微信原生客服;Web 端打开联系客服页(电话/微信号/在线对话) %><a class="pd-kf" data-mp-open-type="contact" href="/service?from=<%= encodeURIComponent('/product/' + p.id) %>" aria-label="联系客服"><svg class="kf-ic" viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="url(#kfg2)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><defs><linearGradient id="kfg2" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#d63a2c"/><stop offset="1" stop-color="#c48f2f"/></linearGradient></defs><path d="M4 14v-2a8 8 0 0 1 16 0v2"/><rect x="3" y="13" width="4" height="6" rx="1.5"/><rect x="17" y="13" width="4" height="6" rx="1.5"/><path d="M19 19c0 1.5-2 2.5-5 2.5"/></svg><span>客服</span></a>
      <% if (canSk) { %>
        <button class="btn primary lg need-no7"<%- dis %> onclick="buy('activity')">⚡ 活动价购买</button>
      <% } else { %>
        <button class="btn gold lg need-no7"<%- dis %> onclick="addCart()">加入购物车</button>
        <button class="btn primary lg need-no7"<%- dis %> onclick="buy('')">立即购买</button>
      <% } %>
      <% if (canGroup) { %><button class="btn lg need-no7"<%- dis %> style="border-color:var(--red);color:var(--red)" onclick="buy('group')">👥 发起拼团 ¥<%= groupbuy.price %>(<%= groupbuy.size %>人团)</button><% } %>
      <button class="btn lg" id="favBtn" onclick="fav()"><%= faved?'★ 已收藏':'☆ 收藏' %></button>
    </div>
    <% if (groupbuy) { %><p class="muted gb-rule" style="font-size:12px;margin:8px 0 0">拼团规则:开团后最迟3小时内成团，未满员也按拼团价发货</p><% } %><% if (openGroups.length) { %><div class="card mt" style="background:#fffaf0;padding:12px 16px"><b>正在拼团,可直接参团:</b><% openGroups.forEach(g=>{ %><div class="flex between" style="margin-top:6px"><span><%= g.nickname.slice(0,1) %>** 发起的团,邀请好友一起拼</span><span class="flex"><a class="btn primary sm" href="/group/<%= g.id %>">去参团</a></span></div><% }) %></div><% } %>
  </div>
</div>
<form id="buyForm" method="post" action="/checkout" class="hide"><input type="hidden" name="_csrf" value="<%= csrf %>"><input name="sku_id"><input name="qty"><input name="promo_type"><input name="promo_id"><input name="group_id"><input name="no7_ok"></form>
<div class="card sec">
  <div class="tabs"><a href="#detail" class="on">商品详情</a><a href="#reviews">用户评价(<%= rs.n %>)</a><a href="#after">售后保障</a></div>
  <div id="detail" class="desc"><%- p.description %><div class="grid g2 mt" style="grid-template-columns:repeat(2,1fr)"><% images.slice(1).forEach(im=>{ %><img loading="lazy" decoding="async" src="<%= im %>" onerror="<%= U.IMG_FALLBACK %>" style="border-radius:10px;width:100%;object-fit:cover"><% }) %></div></div>
</div>
<div class="card sec" id="reviews">
  <div class="sec-h"><h2>用户评价</h2><span class="muted"><% if (!rs.n) { %>暂无评价<% } else if (rs.n < RATE_MIN) { %>共 <%= rs.n %> 条评价 · 综合 <%= (+rs.avg).toFixed(1) %> 分<% } else { %>好评率 <b class="price" style="color:var(--red)"><%= Math.round((rs.good||0)/rs.n*100) %>%</b>(共 <%= rs.n %> 条评价)· 综合 <%= (+rs.avg).toFixed(1) %> 分<% } %></span></div>
  <div class="sortbar"><a class="<%= rv==='all'?'on':'' %>" href="<%= qs(req,{rv:'all'}) %>#reviews">全部</a><a class="<%= rv==='good'?'on':'' %>" href="<%= qs(req,{rv:'good'}) %>#reviews">好评</a><a class="<%= rv==='bad'?'on':'' %>" href="<%= qs(req,{rv:'bad'}) %>#reviews">中差评</a></div>
  <% if (!reviews.length) { %><div class="empty" style="padding:30px">暂无评价</div><% } %>
  <% reviews.forEach(r=>{ %><div class="review"><div class="avatar" style="width:40px;height:40px;font-size:16px"><%= r.nickname.slice(0,1) %></div><div style="flex:1"><div class="flex between"><b><%= r.nick %></b><span class="muted"><%= r.created_at.slice(0,10) %></span></div><div class="stars"><%= '★'.repeat(r.rating)+'☆'.repeat(5-r.rating) %></div><div><%= r.content %></div>
    <% if (r.reply) { %><div class="reply"><b>商家回复:</b><%= r.reply %></div><% } %></div></div><% }) %>
</div>
<div class="card sec" id="after"><div class="sec-h"><h2>售后保障</h2></div><div class="desc">正品保障;本商品支持七天无理由退货,签收后 7 天内可申请退货退款(商品需保持完好);商品存在质量问题的,超过 7 天仍可联系客服申请售后;发票支持个人及企业电子发票;物流信息可在订单中实时查看。</div></div>
<% if (related.length) { %><div class="sec"><div class="sec-h"><h2>相关推荐</h2></div><div class="grid"><% related.forEach(p=>{ %><%- include('../partials/card',{p}) %><% }) %></div></div><% } %>
<script>
(function(){
  var SKUS=<%- JSON.stringify(skus.map(s=>({id:s.id,attrs:s.attrs,price:s.price,stock:s.stock}))) %>, SPECS=<%- JSON.stringify(specs.map(s=>s.name)) %>;
  var SK=<%- JSON.stringify(seckill&&seckill.live?{sku:seckill.sku_id,price:seckill.price,id:seckill.id,left:seckill.stock-seckill.sold,limit:seckill.limit_per_user}:null) %>;
  var GB=<%- JSON.stringify(groupbuy?{sku:groupbuy.sku_id,id:groupbuy.id}:null) %>;
  var PID=<%= p.id %>, LOGGED=<%= user?'true':'false' %>;
  function no7(){return true}
  function no7ok(){return ''}
  function cur(){var sel={};document.querySelectorAll('[data-spec]').forEach(function(g){var o=g.querySelector('.chip.on');sel[g.dataset.spec]=o&&o.dataset.v});
    return SKUS.find(function(s){return SPECS.every(function(n){return s.attrs[n]===sel[n]})})||(SPECS.length?null:SKUS[0])}
  function refresh(){var s=cur();document.getElementById('stock').textContent=s?s.stock:0;
    if(s){var pr=(SK&&SK.sku===s.id)?SK.price:s.price;document.getElementById('price').textContent=pr;var cp=document.getElementById('cloudPrice');if(cp)cp.textContent=(Math.round(s.price*cp.dataset.rate)/100).toFixed(2)}
    document.querySelectorAll('[data-spec]').forEach(function(g){var sel={};document.querySelectorAll('[data-spec]').forEach(function(x){var o=x.querySelector('.chip.on');sel[x.dataset.spec]=o&&o.dataset.v});
      g.querySelectorAll('.chip').forEach(function(c){var t=Object.assign({},sel);t[g.dataset.spec]=c.dataset.v;var ok=SKUS.some(function(s){return SPECS.every(function(n){return s.attrs[n]===t[n]})&&s.stock>0});c.classList.toggle('dis',!ok)})})}
  document.querySelectorAll('.chip').forEach(function(c){c.onclick=function(){c.parentNode.querySelectorAll('.chip').forEach(function(x){x.classList.remove('on')});c.classList.add('on');refresh()}});
  var q=document.getElementById('qty');
  document.getElementById('qm').onclick=function(){q.value=Math.max(1,(+q.value||1)-1)};document.getElementById('qp').onclick=function(){var s=cur();q.value=Math.min(s?s.stock:1,(+q.value||1)+1)};
  function guard(){if(!LOGGED){location.href='/login?next='+encodeURIComponent(location.pathname);return null}var s=cur();if(!s||s.stock<=0){toast('该规格暂时缺货');return null}var n=Math.max(1,parseInt(q.value)||1);if(n>s.stock){toast('库存不足,当前库存 '+s.stock+' 件');return null}if(!no7())return null;return {s:s,n:n}}
  window.addCart=function(){var g=guard();if(!g)return;postJSON('/cart/add',{sku_id:g.s.id,qty:g.n,no7_ok:no7ok()}).then(function(r){toast(r.msg);if(r.ok){var b=document.getElementById('cartBadge');if(b){b.textContent=r.count;b.classList.remove('hide')}}})};
  window.buy=function(type){var g=guard();if(!g)return;var f=document.getElementById('buyForm');
    if(type==='activity'){if(SK.sku!==g.s.id){toast('请选择活动规格');return}if(g.n>SK.limit){toast('每人限购'+SK.limit+'件');return}f.promo_type.value='activity';f.promo_id.value=SK.id}
    else if(type==='group'){if(GB.sku!==g.s.id){toast('拼团仅限默认规格,请选择第一个规格');return}f.promo_type.value='group';f.promo_id.value=GB.id}
    f.no7_ok.value=no7ok();f.sku_id.value=g.s.id;f.qty.value=g.n;f.submit()};
  window.fav=function(){if(!LOGGED){location.href='/login?next='+encodeURIComponent(location.pathname);return}postJSON('/favorite/'+PID,{}).then(function(r){document.getElementById('favBtn').textContent=r.faved?'★ 已收藏':'☆ 收藏';toast(r.faved?'已加入收藏':'已取消收藏')})};
  refresh();
})();
</script>
