<div class="crumb"><a href="/">首页</a> › <% if (category&&category.parent_name) { %><a href="/products?cat=<%= category.parent_cid %>"><%= category.parent_name %></a> › <% } %><% if (category) { %><a href="/products?cat=<%= category.id %>"><%= category.name %></a> › <% } %><%= p.name %></div>
<div class="card pd">
  <div class="gallery"><div class="main"><img id="mainImg" src="<%= images[0] %>" alt=""></div>
    <div class="thumbs"><% images.forEach((im,i)=>{ %><img loading="lazy" decoding="async" src="<%= im %>" class="<%= i===0?'on':'' %>" onclick="document.getElementById('mainImg').src=this.src;document.querySelectorAll('.thumbs img').forEach(x=>x.classList.remove('on'));this.classList.add('on')"><% }) %></div></div>
  <div>
    <h1><% if (brand) { %><span class="tag gold"><%= brand.name %></span><% } %><%= p.name %></h1>
    <div class="subt"><%= p.subtitle %></div>
    <div class="pricebox">
      <% if (seckill) { %><div class="flex between" style="margin-bottom:6px"><span class="tag" style="background:var(--red);color:#fff">⚡ 限时秒杀</span><span><%= seckill.live?'距结束':'距开始' %> <span class="cd" data-countdown="<%= seckill.live?seckill.end_at:seckill.start_at %>" data-reload="1"></span></span></div><% } %>
      <span class="price"><big id="price"><%= (seckill&&seckill.live?seckill.price:p.price) %></big></span>
      <% if (showMkt(p.market_price, p.price)) { %><span class="mkt"><%= p.market_price %></span><% } %>
      <% if (seckill && seckill.live) { %><span class="muted"> 秒杀价,每人限购 <%= seckill.limit_per_user %> 件,剩余 <%= seckill.stock-seckill.sold %> 件</span><% } %>
      <% if (seckill && !seckill.live) { %><span class="muted sk-pre"> 秒杀价 <b style="color:var(--red)">¥<%= seckill.price %></b>,<%= seckill.start_at.slice(5,16) %> 开抢,每人限购 <%= seckill.limit_per_user %> 件</span><% } %>
      <% if (user && user.level_discount<100 && !seckill) { %><div style="font-size:12px;margin-top:4px;color:var(--gold-d)">💎 <%= user.level_name %>专享 <%= user.level_discount/10 %> 折,结算时自动优惠</div><% } %>
    </div>
    <dl class="kv" style="margin:12px 0"><dt>配送</dt><dd>深圳发货</dd>
      <dt>运费</dt><dd class="freight"><% if (freight) { %><b class="<%= freight.free ? 'free' : '' %>"><%= freight.text %></b><% } %> <a class="muted" href="/help">运费规则 ›</a><div class="muted" style="font-size:12px">实际运费在结算页按收货地址计算</div></dd>
      <dt>服务</dt><dd><span class="tag green">正品保证</span><% if (noReason) { %><span class="tag green">支持7天无理由退货</span><% } else { %><span class="tag no7">该商品不支持7天无理由退货</span><% } %><span class="tag green">极速发货</span><% if (!noReason) { %><div class="no7-note">鲜活易腐等商品签收后不支持七天无理由退货;如有质量问题,仍可联系客服退换。</div><% } %></dd>
      <dt>销量</dt><dd>已售 <%= p.sales %> 件 · <%= rateText %></dd></dl>
    <% specs.forEach((s,si)=>{ %><div class="opt"><label><%= s.name %></label><div class="opts" data-spec="<%= s.name %>"><% s.values.forEach((v,vi)=>{ %><span class="chip<%= vi===0?' on':'' %>" data-v="<%= v %>"><%= v %></span><% }) %></div></div><% }) %>
    <div class="opt"><label>数量</label><div class="flex"><div class="qty"><button type="button" id="qm">−</button><input id="qty" value="1" inputmode="numeric"><button type="button" id="qp">+</button></div><span class="muted">库存 <b id="stock">-</b> 件</span></div></div>
    <% const canGroup = groupbuy, canSk = seckill && seckill.live; %>
    <div class="flex wrapf mt">
      <% if (canSk) { %>
        <button class="btn primary lg" onclick="buy('seckill')">⚡ 立即抢购</button>
      <% } else { %>
        <button class="btn gold lg" onclick="addCart()">加入购物车</button>
        <button class="btn primary lg" onclick="buy('')">立即购买</button>
      <% } %>
      <% if (canGroup) { %><button class="btn lg" style="border-color:var(--red);color:var(--red)" onclick="buy('group')">👥 发起拼团 ¥<%= groupbuy.price %>(<%= groupbuy.size %>人团)</button><% } %>
      <button class="btn lg" id="favBtn" onclick="fav()"><%= faved?'★ 已收藏':'☆ 收藏' %></button>
    </div>
    <% if (!noReason) { %><label class="agree no7-ack"><input type="checkbox" id="no7ok"> 本商品不支持7天无理由退货,我已知晓</label><% } %>
    <% if (openGroups.length) { %><div class="card mt" style="background:#fffaf0;padding:12px 16px"><b>正在拼团,可直接参团:</b><% openGroups.forEach(g=>{ %><div class="flex between" style="margin-top:6px"><span><%= g.nickname.slice(0,1) %>** 发起的团,还差 <b style="color:var(--red)"><%= g.need-g.joined %></b> 人</span><span class="flex"><span class="muted">剩余 <span class="cd" data-countdown="<%= g.expire_at %>"></span></span><a class="btn primary sm" href="/group/<%= g.id %>">去参团</a></span></div><% }) %></div><% } %>
  </div>
</div>
<form id="buyForm" method="post" action="/checkout" class="hide"><input type="hidden" name="_csrf" value="<%= csrf %>"><input name="sku_id"><input name="qty"><input name="promo_type"><input name="promo_id"><input name="group_id"></form>
<div class="card sec">
  <div class="tabs"><a href="#detail" class="on">商品详情</a><a href="#reviews">用户评价(<%= rs.n %>)</a><a href="#after">售后保障</a></div>
  <div id="detail" class="desc"><%- p.description %><div class="grid g2 mt" style="grid-template-columns:repeat(2,1fr)"><% images.slice(1).forEach(im=>{ %><img loading="lazy" decoding="async" src="<%= im %>" style="border-radius:10px"><% }) %></div></div>
</div>
<div class="card sec" id="reviews">
  <div class="sec-h"><h2>用户评价</h2><span class="muted"><% if (!rs.n) { %>暂无评价<% } else if (rs.n < RATE_MIN) { %>共 <%= rs.n %> 条评价 · 综合 <%= (+rs.avg).toFixed(1) %> 分<% } else { %>好评率 <b class="price" style="color:var(--red)"><%= Math.round((rs.good||0)/rs.n*100) %>%</b>(共 <%= rs.n %> 条评价)· 综合 <%= (+rs.avg).toFixed(1) %> 分<% } %></span></div>
  <div class="sortbar"><a class="<%= rv==='all'?'on':'' %>" href="<%= qs(req,{rv:'all'}) %>#reviews">全部</a><a class="<%= rv==='good'?'on':'' %>" href="<%= qs(req,{rv:'good'}) %>#reviews">好评</a><a class="<%= rv==='bad'?'on':'' %>" href="<%= qs(req,{rv:'bad'}) %>#reviews">中差评</a></div>
  <% if (!reviews.length) { %><div class="empty" style="padding:30px">暂无评价</div><% } %>
  <% reviews.forEach(r=>{ %><div class="review"><div class="avatar" style="width:40px;height:40px;font-size:16px"><%= r.nickname.slice(0,1) %></div><div style="flex:1"><div class="flex between"><b><%= r.nick %></b><span class="muted"><%= r.created_at.slice(0,10) %></span></div><div class="stars"><%= '★'.repeat(r.rating)+'☆'.repeat(5-r.rating) %></div><div><%= r.content %></div>
    <% if (r.reply) { %><div class="reply"><b>商家回复:</b><%= r.reply %></div><% } %></div></div><% }) %>
</div>
<div class="card sec" id="after"><div class="sec-h"><h2>售后保障</h2></div><div class="desc"><% if (noReason) { %>正品保障;本商品支持七天无理由退货,签收后 7 天内可申请退货退款(商品需保持完好);商品存在质量问题的,超过 7 天仍可联系客服申请售后;<% } else { %>本商品属于鲜活易腐类,不支持七天无理由退货;如商品存在质量问题(如坏果、变质),请于签收后联系客服,核实后为您退款或补发。<% } %>发票支持个人及企业电子发票;物流信息可在订单中实时查看。</div></div>
<% if (related.length) { %><div class="sec"><div class="sec-h"><h2>相关推荐</h2></div><div class="grid"><% related.forEach(p=>{ %><%- include('../partials/card',{p}) %><% }) %></div></div><% } %>
<script>
(function(){
  var SKUS=<%- JSON.stringify(skus.map(s=>({id:s.id,attrs:s.attrs,price:s.price,stock:s.stock}))) %>, SPECS=<%- JSON.stringify(specs.map(s=>s.name)) %>;
  var SK=<%- JSON.stringify(seckill&&seckill.live?{sku:seckill.sku_id,price:seckill.price,id:seckill.id,left:seckill.stock-seckill.sold,limit:seckill.limit_per_user}:null) %>;
  var GB=<%- JSON.stringify(groupbuy?{sku:groupbuy.sku_id,id:groupbuy.id}:null) %>;
  var PID=<%= p.id %>, LOGGED=<%= user?'true':'false' %>, NO7=<%= noReason?'false':'true' %>;
  function no7(){if(!NO7)return true;var c=document.getElementById('no7ok');if(c.checked)return true;if(confirm('本商品不支持7天无理由退货,我已知晓。\n\n点击「确定」表示您已知晓并继续。')){c.checked=true;return true}return false}
  function cur(){var sel={};document.querySelectorAll('[data-spec]').forEach(function(g){var o=g.querySelector('.chip.on');sel[g.dataset.spec]=o&&o.dataset.v});
    return SKUS.find(function(s){return SPECS.every(function(n){return s.attrs[n]===sel[n]})})||(SPECS.length?null:SKUS[0])}
  function refresh(){var s=cur();document.getElementById('stock').textContent=s?s.stock:0;
    if(s){var pr=(SK&&SK.sku===s.id)?SK.price:s.price;document.getElementById('price').textContent=pr}
    document.querySelectorAll('[data-spec]').forEach(function(g){var sel={};document.querySelectorAll('[data-spec]').forEach(function(x){var o=x.querySelector('.chip.on');sel[x.dataset.spec]=o&&o.dataset.v});
      g.querySelectorAll('.chip').forEach(function(c){var t=Object.assign({},sel);t[g.dataset.spec]=c.dataset.v;var ok=SKUS.some(function(s){return SPECS.every(function(n){return s.attrs[n]===t[n]})&&s.stock>0});c.classList.toggle('dis',!ok)})})}
  document.querySelectorAll('.chip').forEach(function(c){c.onclick=function(){c.parentNode.querySelectorAll('.chip').forEach(function(x){x.classList.remove('on')});c.classList.add('on');refresh()}});
  var q=document.getElementById('qty');
  document.getElementById('qm').onclick=function(){q.value=Math.max(1,(+q.value||1)-1)};document.getElementById('qp').onclick=function(){var s=cur();q.value=Math.min(s?s.stock:1,(+q.value||1)+1)};
  function guard(){if(!LOGGED){location.href='/login?next='+encodeURIComponent(location.pathname);return null}var s=cur();if(!s||s.stock<=0){toast('该规格暂时缺货');return null}var n=Math.max(1,parseInt(q.value)||1);if(n>s.stock){toast('库存不足,仅剩 '+s.stock+' 件');return null}if(!no7())return null;return {s:s,n:n}}
  window.addCart=function(){var g=guard();if(!g)return;postJSON('/cart/add',{sku_id:g.s.id,qty:g.n,no7_ok:NO7?'1':''}).then(function(r){toast(r.msg);if(r.ok){var b=document.getElementById('cartBadge');if(b){b.textContent=r.count;b.classList.remove('hide')}}})};
  window.buy=function(type){var g=guard();if(!g)return;var f=document.getElementById('buyForm');
    if(type==='seckill'){if(SK.sku!==g.s.id){toast('请选择秒杀规格');return}if(g.n>SK.limit){toast('每人限购'+SK.limit+'件');return}f.promo_type.value='seckill';f.promo_id.value=SK.id}
    else if(type==='group'){if(GB.sku!==g.s.id){toast('拼团仅限默认规格,请选择第一个规格');return}f.promo_type.value='group';f.promo_id.value=GB.id}
    f.sku_id.value=g.s.id;f.qty.value=g.n;f.submit()};
  window.fav=function(){if(!LOGGED){location.href='/login?next='+encodeURIComponent(location.pathname);return}postJSON('/favorite/'+PID,{}).then(function(r){document.getElementById('favBtn').textContent=r.faved?'★ 已收藏':'☆ 收藏';toast(r.faved?'已加入收藏':'已取消收藏')})};
  refresh();
})();
</script>
