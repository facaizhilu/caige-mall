<div class="me"><%- include("_menu",{cur:"history"}) %><div class="card"><div class="flex between"><h3 style="margin-top:0">浏览记录</h3><% if(rows.length){ %><form method="post" action="/me/history/clear" data-confirm="确定清空全部浏览记录?清空后无法恢复。"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm">🗑 清空浏览记录</button></form><% } %></div>
<p class="muted" style="font-size:12px;margin:0 0 10px">浏览记录仅您本人可见,不用于个性化推荐;可单条删除或一键清空。</p>
<% if(!rows.length){ %><div class="empty"><div class="e">👣</div>暂无浏览记录</div><% } else { %><div class="grid g3 hist-grid"><% rows.forEach(p=>{ %><div class="hist-item"><%- include('../partials/card',{p}) %><div class="hist-meta"><span class="muted"><%= U.timeAgo(p.viewed_at) %>浏览</span><form method="post" action="/me/history/<%= p.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link danger-t" title="删除这条浏览记录">删除</button></form></div></div><% }) %></div><% } %></div></div>
