<div class="me"><%- include("_menu",{cur:"history"}) %><div class="card"><div class="flex between"><h3 style="margin-top:0">浏览记录</h3><% if(rows.length){ %><form method="post" action="/me/history/clear" data-confirm="清空浏览记录?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm">清空</button></form><% } %></div>
<% if(!rows.length){ %><div class="empty"><div class="e">👣</div>暂无浏览记录</div><% } else { %><div class="grid g3" style="grid-template-columns:repeat(3,1fr)"><% rows.forEach(p=>{ %><div><%- include('../partials/card',{p}) %><div class="muted" style="font-size:12px;text-align:center"><%= U.timeAgo(p.viewed_at) %>浏览</div></div><% }) %></div><% } %></div></div>
