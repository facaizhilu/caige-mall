<section class="card cz-zone"><a class="muted" href="/cloud-zone">返回云商专区</a><h1><%= p.name %></h1><img class="cz-photo" src="<%= U.firstImg(p.images) %>" alt="" onerror="<%= U.IMG_FALLBACK %>"><p class="cz-product-price">专区售价 <%= money(p.price) %></p><p class="muted">按后台设置的专区售价结算，不叠加普通商城折扣、优惠券或积分抵扣；运费按收货地址计算。</p><p><span class="tag <%= noReason?'green':'no7' %>"><%= noReason?'支持7天无理由退货':'该商品不支持7天无理由退货' %></span></p>
<form method="post" action="/checkout"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="form-row"><label for="czsku">规格</label><select id="czsku" name="sku_id" required><% skus.forEach(s=>{ %><option value="<%= s.id %>" <%= s.stock<=0?'disabled':'' %>><%= s.spec_text %> · <%= money(s.price) %> · 库存<%= s.stock %></option><% }) %></select></div><div class="form-row"><label for="czqty">数量</label><input id="czqty" name="qty" type="number" min="1" max="1000000" step="1" value="1" required></div>
<% if(!noReason){ %><label class="agree no7-ack"><input type="checkbox" name="no7_ok" value="1" required>本商品不支持7天无理由退货，我已知晓</label><% } %><div class="cz-buybar"><button class="cz-button" <%= !skus.some(s=>s.stock>0)?'disabled':'' %>><%= skus.some(s=>s.stock>0)?'立即购买':'暂时缺货' %></button></div></form><h3>商品详情</h3><div class="cz-desc"><%= p.description %></div></section>
