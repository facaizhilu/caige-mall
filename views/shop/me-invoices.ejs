<div class="me"><%- include("_menu",{cur:"invoices"}) %><div class="card"><h3 style="margin-top:0">我的发票</h3><p class="muted">在订单详情页可申请电子发票。</p>
<table class="tbl"><tr><th>订单号</th><th>抬头</th><th>金额</th><th>状态</th><th>申请时间</th></tr><% rows.forEach(i=>{ %><tr><td><a href="/order/<%= i.order_id %>"><%= i.order_no %></a></td><td><%= i.title %></td><td><%= money(i.amount) %></td><td><%= {pending:'待开具',issued:'已开具 '+(i.invoice_no||''),rejected:'已驳回:'+(i.admin_note||'')}[i.status] %></td><td><%= i.created_at %></td></tr><% }) %></table><% if(!rows.length){ %><div class="empty">暂无发票申请</div><% } %></div></div>
