<% const P=t=>String(t).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c])).replace(/\*\*(.+?)\*\*/g,"<b>$1</b>"); %><div class="crumb"><a href="/">首页</a> › <%= d.title %></div>
<div class="card about-page"><% if(d.cover){ %><img class="about-cover" src="<%= d.cover %>" alt="<%= d.title %>" style="width:100%;max-height:360px;object-fit:cover;border-radius:10px;display:block;margin-bottom:12px"><% }else{ %><div class="original-full"><img src="/static/img/logo-horizontal-onred.svg" alt="韵农甄选" width="212" height="68"></div><% } %>
<h2 style="margin-top:0"><%= d.title %></h2><% if(d.intro){ %><div class="about-intro" style="color:#1F6B3F;background:#E8F6EE;border-radius:8px;padding:10px 12px;margin-bottom:12px"><% d.intro.split(/\r?\n/).filter(s=>s.trim()).forEach(s=>{ %><p style="margin:4px 0"><%= s %></p><% }) %></div><% } %>
<div class="desc" style="font-size:15px;line-height:1.7;overflow-wrap:anywhere"><% d.blocks.forEach(b=>{ %><section class="about-block" style="margin-bottom:16px"><% if(b.image){ %><img src="<%= b.image %>" alt="" loading="lazy" style="width:100%;border-radius:10px;display:block;margin-bottom:8px"><% } %><% String(b.text||'').split(/\r?\n/).filter(s=>s.trim()).forEach(s=>{ %><p><%- P(s) %></p><% }) %></section><% }) %></div><div class="about-foot" style="border-top:1px solid #eee;margin-top:8px;padding-top:12px;text-align:center;color:#666;font-size:13px;line-height:1.8"><div>海南韵农科技有限公司</div><% if(info.phoneReal){ %><div>客服电话：<a href="tel:<%= info.phone %>"><%= info.phone %></a></div><% } %></div></div>
