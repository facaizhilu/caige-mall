<section class="cz-card-page" id="cloud-zone-entry"><div class="cz-member-card"><span class="cz-card-blob" aria-hidden="true"></span><h1>云商卡</h1><p>云商会员价 · 专属权益</p><small><% if(status.active&&card){ %><%= card.name %> · 有效期至 <%= String(status.end||'').slice(0,10) %><% }else if(status.tier){ %><%= status.label %><% }else{ %>韵农甄选<% } %></small></div><button class="cz-button" id="cz-open" type="button" aria-haspopup="dialog">体验生态专区</button></section>
<dialog class="cz-sheet" id="cz-sheet" aria-labelledby="cz-title"><div class="cz-sheet-head"><h2 id="cz-title">体验生态专区</h2><button type="button" id="cz-close" aria-label="关闭">×</button></div><form method="post" action="/cloud-zone/enter" id="cz-form" novalidate><input type="hidden" name="_csrf" value="<%= csrf %>"><input aria-label="手机号" id="cz-phone" name="phone" type="tel" inputmode="numeric" autocomplete="tel" maxlength="11" pattern="1[3-9][0-9]{9}" placeholder="请输入手机号" required aria-describedby="cz-notice"><p id="cz-notice" class="cz-notice" role="status" <%= typeof zoneEntryError==='undefined'||!zoneEntryError?'hidden':'' %>><%= typeof zoneEntryError!=='undefined'?zoneEntryError:'' %></p><button class="cz-button">确定</button></form></dialog>
<noscript><style>.cz-sheet:not([open]){display:block;position:static;transform:none;margin:20px auto}.cz-sheet #cz-close{display:none}</style></noscript>
<script>(function(){
var d=document.getElementById('cz-sheet'),open=document.getElementById('cz-open'),close=document.getElementById('cz-close'),phone=document.getElementById('cz-phone'),note=document.getElementById('cz-notice'),nativeDialog=typeof d.showModal==='function',mask=document.createElement('div');mask.className='cz-fallback-mask';mask.hidden=true;document.body.appendChild(mask);
function restore(){document.body.style.overflow='';phone.value='';note.textContent='';note.hidden=true;open.focus()}function show(){if(nativeDialog)d.showModal();else{d.setAttribute('open','');mask.hidden=false}document.body.style.overflow='hidden';phone.focus()}function hide(){if(nativeDialog)d.close();else{d.removeAttribute('open');mask.hidden=true;restore()}}
open.addEventListener('click',show);close.addEventListener('click',hide);mask.addEventListener('click',hide);d.addEventListener('close',restore);document.addEventListener('keydown',function(e){if(e.key==='Escape'&&!nativeDialog&&d.hasAttribute('open'))hide()});d.addEventListener('click',function(e){var r=d.getBoundingClientRect();if(e.target===d&&(e.clientY<r.top||e.clientX<r.left||e.clientX>r.right))hide()});document.getElementById('cz-form').addEventListener('submit',function(e){if(!/^1[3-9]\d{9}$/.test(phone.value.trim())){e.preventDefault();note.textContent='请输入正确的手机号';note.hidden=false;phone.focus()}});<% if(typeof zoneEntryError!=='undefined'&&zoneEntryError){ %>show();<% } %>})();</script>
