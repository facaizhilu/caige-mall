<div class="me"><%- include("_menu",{cur:"reviews"}) %><div class="card"><h3 style="margin-top:0">我的评价</h3>
<% if(!rows.length){ %><div class="empty">暂无评价</div><% } %>
<% rows.forEach(r=>{ %><div class="review"><img loading="lazy" decoding="async" src="<%= r.pimg %>" style="width:64px;height:64px;border-radius:8px;object-fit:cover"><div style="flex:1"><a href="/product/<%= r.product_id %>"><b><%= r.pname %></b></a> <span class="tag <%= r.status==='approved'?'green':'' %>"><%= {pending:'审核中',approved:'已展示',rejected:'未通过'}[r.status] %></span><div class="stars"><%= '★'.repeat(r.rating) %></div><div><%= r.content %></div><% if(r.imgs.length){ %><div class="rimgs"><% r.imgs.forEach(i=>{ %><img loading="lazy" decoding="async" src="<%= i %>"><% }) %></div><% } %><% if(r.reply){ %><div class="reply">商家回复:<%= r.reply %></div><% } %></div></div><% }) %></div></div>
