<div class="me"><%- include("_menu",{cur:"reviews"}) %><div class="card"><h3 style="margin-top:0">我的评价</h3>
<% if(!rows.length){ %><div class="empty">暂无评价</div><% } %>
<% rows.forEach(r=>{ %><div class="review"><img loading="lazy" decoding="async" src="<%= r.pimg %>" style="width:64px;height:64px;border-radius:8px;object-fit:cover"><div style="flex:1"><a href="/product/<%= r.product_id %>"><b><%= r.pname %></b></a> <span class="tag <%= r.status==='approved'?'green':'' %>"><%= {pending:'审核中',approved:'已展示',rejected:'未通过',hidden:'已隐藏'}[r.status] %></span><div class="stars"><%= '★'.repeat(r.rating) %></div><div><%= r.content %></div><% if(r.reply){ %><div class="reply">商家回复:<%= r.reply %></div><% } %>
<form method="post" action="/me/reviews/<%= r.id %>/delete" data-confirm="确定删除这条评价?删除后不可恢复,也不能再次评价该商品;已获得的评价积分不会扣回。" class="mt"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm">删除我的评价</button></form></div></div><% }) %></div></div>
