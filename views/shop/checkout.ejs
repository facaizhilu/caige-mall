<div class="crumb"><a href="/">首页</a> › <a href="/cart">购物车</a> › 确认订单</div>
<form method="post" action="/order/create" id="ckForm">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <% if (fromCart) { %><input type="hidden" name="from_cart" value="1"><% } %>
  <input type="hidden" name="items" value='<%= JSON.stringify(items) %>'>
  <% if (promo) { %><input type="hidden" name="promo_type" value="<%= promo.type %>"><input type="hidden" name="promo_id" value="<%= promo.id %>"><input type="hidden" name="group_id" value="<%= promo.groupId||'' %>"><% } %>
  <div class="card ck-sec"><h3>📍 收货地址</h3>
    <div class="addrs">
      <% addrs.forEach((a,i)=>{ %><label class="addr<%= i===0?' on':'' %>"><input type="radio" name="address_id" value="<%= a.id %>" data-prov="<%= a.province %>" <%= i===0?'checked':'' %>><b><%= a.name %></b> <%= a.phone %> <% if (a.is_default) { %><span class="tag">默认</span><% } %><br><span class="muted"><%= a.province %> <%= a.city %> <%= a.district %> <%= a.detail %></span></label><% }) %>
      <label class="addr<%= !addrs.length?' on':'' %>"><input type="radio" name="address_id" value="new" <%= !addrs.length?'checked':'' %>><b>＋ 使用新地址</b><br><span class="muted">填写省市区与详细地址</span></label>
    </div>
    <div id="newAddr" class="mt <%= addrs.length?'hide':'' %>" data-region="">
      <div class="grid g2" style="grid-template-columns:1fr 1fr">
        <div class="form-row"><label>收货人</label><input name="new_name" maxlength="20"></div><div class="form-row"><label>手机号</label><input name="new_phone" type="tel" maxlength="11"></div>
      </div>
      <div class="grid g3" style="grid-template-columns:repeat(3,1fr)"><select name="new_province" data-r="province"></select><select name="new_city" data-r="city"></select><select name="new_district" data-r="district"></select></div>
      <div class="form-row mt"><input name="new_detail" placeholder="街道、门牌号等详细地址" maxlength="100"></div>
      <label><input type="checkbox" name="save_addr" value="1" checked style="width:auto"> 保存到我的地址</label>
    </div>
  </div>
  <div class="card ck-sec"><h3>🛍️ 商品清单</h3>
    <% q.lines.forEach(l=>{ %><div class="oi"><img src="<%= l.image %>"><div style="flex:1"><b><%= l.name %></b><br><span class="muted"><%= l.spec_text %></span></div><span class="price"><%= l.price %></span><span>× <%= l.qty %></span></div><% }) %>
    <div class="form-row mt"><label>订单备注</label><input name="remark" maxlength="100" placeholder="选填,如:请工作日送货"></div>
  </div>
  <% if (!promo) { %>
  <div class="card ck-sec"><h3>🎟️ 优惠</h3>
    <div class="form-row"><label>优惠券(<%= coupons.length %> 张可用)</label>
      <select name="coupon_id" id="coupon"><option value="">不使用优惠券</option><% coupons.forEach(c=>{ %><option value="<%= c.id %>">减¥<%= c.amount %> · <%= c.name %>(<%= c.threshold?'满'+c.threshold:'无门槛' %>)· 至<%= c.expire_at.slice(0,10) %></option><% }) %></select></div>
    <div class="form-row"><label>积分抵扣(持有 <%= user.points %> 积分,<%= q.rate %> 积分抵 ¥1,最多可用 <b id="maxpts"><%= q.maxPoints %></b>)</label>
      <div class="flex"><input type="number" name="use_points" id="pts" min="0" value="0" step="<%= q.rate %>" style="max-width:200px"><button type="button" class="btn sm" id="useMax">全部使用</button></div></div>
  </div>
  <% } %>
  <div class="card ck-sec"><h3>💳 支付方式 <span class="tag gold">模拟支付 · 不产生真实扣款</span></h3><p class="muted" style="margin:0">下一步在收银台选择微信 / 支付宝 / 余额(<%= user.balance.toFixed(2) %> 元)进行模拟支付。</p></div>
  <div class="card">
    <dl class="kv" style="grid-template-columns:1fr auto;max-width:420px;margin-left:auto">
      <dt>商品金额</dt><dd class="right" id="rGoods"><%= money(q.goods) %></dd>
      <dt>运费</dt><dd class="right" id="rFreight"><%= money(q.freight) %></dd>
      <dt><%= q.levelName %>会员折扣</dt><dd class="right" id="rLevel">-<%= money(q.levelDiscount) %></dd>
      <dt>优惠券</dt><dd class="right" id="rCoupon">-<%= money(q.couponDiscount) %></dd>
      <dt>积分抵扣</dt><dd class="right" id="rPts">-<%= money(q.pointsDiscount) %></dd>
    </dl>
    <div class="flex between mt"><span class="muted">提交订单后需在 <%= shop.unpaid_cancel_minutes %> 分钟内支付,超时自动取消</span><span class="flex">应付:<span class="price"><big id="rPay"><%= q.pay.toFixed(2) %></big></span><button class="btn primary lg">提交订单</button></span></div>
  </div>
</form>
<script>
(function(){
  var f=document.getElementById('ckForm');
  function prov(){var r=f.querySelector('[name=address_id]:checked');if(!r)return '';if(r.value==='new')return f.querySelector('[name=new_province]').value;return r.dataset.prov}
  function m(n){return '¥'+(+n).toFixed(2)}
  function recalc(){var d={items:f.items.value,address_id:(f.querySelector('[name=address_id]:checked')||{}).value,province:prov(),coupon_id:f.coupon?f.coupon.value:'',use_points:f.use_points?f.use_points.value:0};
    var pt=f.querySelector('[name=promo_type]');if(pt){d.promo_type=pt.value;d.promo_id=f.promo_id.value;d.group_id=f.group_id.value}
    postJSON('/api/quote',d).then(function(r){if(!r.ok){toast(r.msg);return}rGoods.textContent=m(r.goods);rFreight.textContent=m(r.freight);rLevel.textContent='-'+m(r.levelDiscount);rCoupon.textContent='-'+m(r.couponDiscount);rPts.textContent='-'+m(r.pointsDiscount);rPay.textContent=r.pay.toFixed(2);if(f.use_points&&+f.use_points.value>r.pointsUsed){f.use_points.value=r.pointsUsed}document.getElementById('maxpts')&&(maxpts.textContent=r.maxPoints)})}
  f.querySelectorAll('[name=address_id]').forEach(function(r){r.addEventListener('change',function(){newAddr.classList.toggle('hide',r.value!=='new'||!r.checked);recalc()})});
  newAddr.addEventListener('regionchange',recalc);
  if(f.coupon)f.coupon.onchange=recalc;if(f.use_points){f.use_points.onchange=recalc;useMax.onclick=function(){f.use_points.value=document.getElementById('maxpts').textContent;recalc()}}
})();
</script>
