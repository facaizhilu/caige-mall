<div class="crumb"><a href="/aftersales">退款/售后</a> › 售后详情</div>
<div class="card"><div class="flex between"><h3 style="margin:0">售后单 #<%= a.id %>(订单 <a href="/order/<%= a.order_id %>"><%= a.order_no %></a>)</h3><span class="os <%= a.status %>"><%= AFTERSALE_STATUS[a.status] %></span></div>
<% const estPts = a.pay_amount > 0 ? Math.round((a.points_used||0) * Math.min(1, a.amount / a.pay_amount)) : (a.points_used||0); %>
<dl class="kv mt"><dt>类型</dt><dd><%= AFTERSALE_TYPE[a.type] || a.type %></dd>
<% if (a.status==='refunded') { %><dt>退款明细</dt><dd><b>退积分 <%= a.refund_points||0 %></b> / <b style="color:var(--red,#2E9E5B)">退现金 ¥<%= (a.refund_cash||0).toFixed(2) %></b><div class="muted" style="font-size:12px">现金<%= a.refund_channel||'原路退回' %><% if (demo) { %>(模拟退款)<% } %>· <%= a.refunded_at||'' %></div></dd>
<% } else if (!['exchanged','rejected','cancelled'].includes(a.status)) { %><dt>退款金额</dt><dd>退积分 <%= estPts %> / 退现金 ¥<%= a.amount.toFixed(2) %><div class="muted" style="font-size:12px">退款完成后现金原路退回,订单使用的积分按比例退回</div></dd><% } %>
<dt>原因</dt><dd><%= a.reason %></dd><dt>说明</dt><dd><%= a.description||'-' %></dd><dt>商家说明</dt><dd><%= a.admin_note||'-' %></dd><dt>创建时间</dt><dd><%= a.created_at %></dd><dt>最近更新</dt><dd><%= a.updated_at||'-' %></dd>
<% if(a.return_tracking){ %><dt>退货物流</dt><dd><%= a.return_express %> <%= a.return_tracking %></dd><% } %></dl>
<% if(a.status==='rejected'){ %><p class="as-rejected">拒绝原因：<%= a.admin_note||'请联系客服了解详情' %></p><% } %>
<div class="as-return"><b>退货地址与运费说明</b><% if(aftersaleDisplay.addresses.length){ aftersaleDisplay.addresses.forEach(x=>{ %><p class="as-address"><span><%= x %></span><button type="button" class="btn sm as-copy">复制地址</button></p><% }); }else{ %><p>退货地址待客服确认，请勿自行寄往商家注册地址。</p><% } %><p><%= aftersaleDisplay.shippingNote %></p></div>
<%- include('../partials/aftersale-history',{aftersaleDisplay}) %>
<% if(a.created_by){ %><p class="muted">本单由客服代建</p><% } %>
<% if(a.status==='approved_return' && a.supplier && a.supplier_pick_type===1){ %><p class="as-return">供应商安排上门取件，请保持电话畅通，无需自行寄回。</p><% } %>
<% if(a.status==='approved_return' && !(a.supplier && a.supplier_pick_type===1)){ %><div class="sim mt">商家已同意退货，请核对上方退货地址与运费说明，寄回后填写物流信息。</div>
<form method="post" action="/aftersale/<%= a.id %>/return" class="flex mt wrapf"><input type="hidden" name="_csrf" value="<%= csrf %>"><select name="company" style="max-width:180px"><option>顺丰速运</option><option>中通快递</option><option>圆通速递</option><option>韵达快递</option><option>京东物流</option></select><input name="tracking" placeholder="退货运单号" required style="max-width:240px"><button class="btn primary">提交退货信息</button></form><% } %>
<p class="muted mt" style="font-size:12px">售后单由客服根据您的申请创建,处理进度也会通过客服消息通知您。如需补充说明或取消售后,请<a href="/service">联系客服</a>。</p></div>

<script>
document.querySelectorAll('.as-copy').forEach(function(b){b.onclick=function(){var t=b.previousElementSibling.textContent;var ok=function(){b.textContent='已复制'};var fallback=function(){var e=document.createElement('textarea');e.value=t;e.style.position='fixed';e.style.opacity='0';document.body.appendChild(e);e.select();try{if(document.execCommand('copy'))ok();else window.prompt('复制退货地址',t)}catch(x){window.prompt('复制退货地址',t)}e.remove()};if(navigator.clipboard&&window.isSecureContext)navigator.clipboard.writeText(t).then(ok,fallback);else fallback()}});
</script>
