<div class="crumb"><a href="/">首页</a> › 领券中心</div>
<div class="card" style="background:linear-gradient(120deg,var(--red),var(--gold));color:#fff;text-align:center;margin-bottom:18px"><h2 style="margin:0">🎟️ 领券中心</h2><p style="margin:4px 0 0">先领券,再下单,省钱更省心</p></div>
<div class="grid g2" style="grid-template-columns:1fr 1fr"><% rows.forEach(c=>{ const out=c.claimed>=c.total, max=c.mine>=c.per_limit; %><div class="coupon <%= out?'off':'' %>"><div class="l"><b><%= c.amount %></b><small><%= c.threshold?'满'+c.threshold+'可用':'无门槛' %></small></div><div class="r"><b><%= c.name %></b><span class="muted"><%= c.description %><%= c.cat_name?' · 限'+c.cat_name:'' %></span><span class="muted">领取后 <%= c.valid_days %> 天有效 · 每人限领 <%= c.per_limit %> 张 · 剩余 <%= Math.max(0,c.total-c.claimed) %></span></div>
 <div class="act"><form method="post" action="/coupons/<%= c.id %>/claim"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn primary sm" <%= out||max?'disabled':'' %>><%= out?'已抢光':(max?'已领取':'立即领取') %></button></form></div></div><% }) %></div>
