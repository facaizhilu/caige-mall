<!doctype html>
<html lang="zh-CN"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#9e1712"><meta name="format-detection" content="telephone=no">
<meta name="csrf" content="<%= csrf %>">
<title><%= title %> - <%= shop.shop_name %></title>
<link rel="icon" href="/favicon.ico" sizes="any"><link rel="icon" type="image/svg+xml" href="/static/img/badge-chip.svg?v=1"><link rel="icon" type="image/png" href="/static/img/favicon-64.png"><link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="stylesheet" href="/static/css/shop.css?v=15">
<link rel="stylesheet" href="/static/css/chrome.css?v=3">
</head><body class="<%= /^\/product\/\d+/.test(req.path) ? 'pg-pd' : req.path === '/service' ? 'pg-chat' : '' %>">
<div class="ztop">
<% if (shop.announcement && ['/', '/products', '/cart', '/me'].includes(req.path)) { %><a class="zann" href="/notices" title="<%= shop.announcement %>"><span><%= shop.announcement %></span></a><% } %>
<%- include('../partials/header') %>
</div>
<div class="wrap"><% if (flash) { %><div class="flash <%= flash.type %>"><%= flash.msg %></div><% } %></div>
<main><div class="wrap"><%- body %></div></main>
<footer class="footer"><div class="wrap">
  <div class="cols">
    <div><h4><%= shop.shop_name %></h4><p><%= shop.slogan %></p><p>客服 <%= shop.service_phone %><%= shop.service_phone==='400-888-6666'?'(演示)':'' %><br><%= shop.service_hours %></p></div>
    <div><h4>新手指南</h4><a href="/help">注册与登录</a><a href="/help">如何下单</a><a href="/points-rules">积分规则</a></div>
    <div><h4>配送与售后</h4><a href="/help">运费规则</a><a href="/aftersales">退款/售后</a><a href="/me/invoices">发票说明</a></div>
    <div><h4>关于我们</h4><a href="/article/<%= aboutId %>">关于<%= shop.shop_name %></a><a href="/notices">商城公告</a><a href="/service">联系客服</a><a href="/terms">用户协议</a><a href="/privacy">隐私政策</a><a href="/admin">商家后台</a></div>
  </div>
  <div class="cp">© 2026 <%= shop.shop_name %><% if (shop.icp) { %> · <%= shop.icp %><% } %><span class="cp-x"> · 本站为演示站点,所有商品与订单均为虚构,支付为模拟支付 · <%= shop.address %></span></div>
</div></footer>
<%- include('../partials/tabbar') %>
<script>window.REGIONS=<%- JSON.stringify(regions) %>;</script>
<script src="/static/js/app.js?v=5"></script>
</body></html>
