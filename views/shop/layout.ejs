<!doctype html>
<html lang="zh-CN"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#23894C"><meta name="format-detection" content="telephone=no">
<meta name="csrf" content="<%= csrf %>">
<title><%= title %> - <%= shop.shop_name %></title>
<link rel="icon" href="/favicon.ico?v=2" sizes="any"><link rel="icon" type="image/svg+xml" href="/static/img/logo-orig-mark.svg?v=1"><link rel="icon" type="image/png" href="/static/img/favicon-64.png?v=2"><link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2">
<link rel="stylesheet" href="/static/css/shop.css?v=20">
<link rel="stylesheet" href="/static/css/chrome.css?v=8">
<link rel="stylesheet" href="/static/css/green.css?v=16">
</head><body class="g-theme <%= /^\/product\/\d+/.test(req.path) ? 'pg-pd' : req.path === '/service' ? 'pg-chat' : '' %> pg-<%= req.path.slice(1).replace(/\//g, '-').replace(/[^a-z-]/g, '') || 'home' %>">
<div class="ztop <%= ['/', '/products', '/cart'].includes(req.path) ? 'ztop-arc' : 'ztop-w' %><%= req.path === '/me' ? ' ztop-none' : '' %>">
<%- include('../partials/header') %>
</div>
<div class="wrap"><% if (flash) { %><div class="flash <%= flash.type %>"><%= flash.msg %></div><% } %></div>
<main><div class="wrap"><%- body %></div></main>
<footer class="footer"><div class="wrap">
  <div class="cols">
    <div><h4><%= shop.shop_name %></h4><p><%= shop.slogan %></p><p>客服 <%= pub.phone %><br><%= shop.service_hours %></p></div>
    <div><h4>新手指南</h4><a href="/help">注册与登录</a><a href="/help">如何下单</a><a href="/points-rules">积分规则</a></div>
    <div><h4>配送与售后</h4><a href="/help">运费规则</a><a href="/aftersales">退款/售后</a><a href="/me/invoices">发票说明</a></div>
    <div><h4>关于我们</h4><a href="/article/<%= aboutId %>">关于<%= shop.shop_name %></a><a href="/notices">商城公告</a><a href="/service">联系客服</a><a href="/terms">用户协议</a><a href="/privacy">隐私政策</a><a href="/admin">商家后台</a></div>
  </div>
  <div class="cp">© 2026 <%= shop.shop_name %><% if (pub.icp) { %> · <%= pub.icp %><% } %></div><%- include('../partials/operator') %>
</div></footer>
<%- include('../partials/tabbar') %>
<script>window.REGIONS=<%- JSON.stringify(regions) %>;</script>
<script src="/static/js/app.js?v=9"></script>
</body></html>
